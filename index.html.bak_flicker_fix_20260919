            return `
                <div style="background: rgba(0,0,0,0.7); border: 1px solid ${sintonizado ? '#a855f7' : '#3b0764'}; border-radius: 8px; padding: 14px; ${sintonizado ? 'box-shadow: 0 0 12px rgba(147,51,234,0.3);' : ''}">
