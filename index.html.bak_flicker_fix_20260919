                        btnConfirmar.disabled = false;
                        btnConfirmar.style.borderColor = "#0f5";
                        btnConfirmar.style.color = "#0f5";
                    } else {
                        btnConfirmar.disabled = true;
                        btnConfirmar.style.borderColor = "#555";
                        btnConfirmar.style.color = "#555";
                    }
                }
            }
        });
    }

