    async function moverMundo2D(dx, dy) {
        if (!meuVampiro || !m2dEstado) return;
        try {
            const res = await fetch('/api/mundo2d/mover', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: meuVampiro.id, dx, dy })
            });
            const dados = await res.json();
            if (dados.erro) {
                mostrarNotificacaoMundo2D("⚠️ " + dados.erro);
                return;
            }
            if (dados.sucesso && m2dEstado.jogadores[meuVampiro.id]) {
                m2dEstado.jogadores[meuVampiro.id].x = dados.x;
                m2dEstado.jogadores[meuVampiro.id].y = dados.y;
                m2dCamera.x = dados.x;
                m2dCamera.y = dados.y;
                atualizarHUDZonaMundo2D(dados.x, dados.y);
                verificarProximidadeMundo2D();
            }
        } catch(e) {}
    }

    function verificarProximidadeMundo2D() {
        if (!meuVampiro || !m2dEstado) return;
        const j = m2dEstado.jogadores[meuVampiro.id];
        if (!j) return;

        m2dInteracaoProxima = null;

        // 1. Edificações da Cidade
        const edifs = m2dEstado.edificacoesCidade || {};
        for (let id in edifs) {
            const ed = edifs[id];
            const dist = Math.hypot(ed.x - j.x, ed.y - j.y);
            if (dist <= 2.2) {
                m2dInteracaoProxima = { tipo: 'edificacao', id, item: ed, prompt: `[E] ${ed.nome}` };
                return;
            }
        }

        // 2. Monstros
        for (let id in m2dEstado.monstros) {
            const mob = m2dEstado.monstros[id];
            const dist = Math.hypot(mob.x - j.x, mob.y - j.y);
            if (dist <= 2.2) {
                m2dInteracaoProxima = { tipo: 'monstro', id, item: mob, prompt: `[Espaço] Golpear ${mob.nome} (Nv.${mob.nivel})` };
                return;
            }
        }

        // 3. Mortais
        for (let id in m2dEstado.mortais) {
            const m = m2dEstado.mortais[id];
            const dist = Math.hypot(m.x - j.x, m.y - j.y);
            if (dist <= 2.2) {
                m2dInteracaoProxima = { tipo: 'mortal', id, item: m, prompt: `[E] 🩸 Morder ${m.nome} (Drenar Vitae)` };
                return;
            }
        }

        // 4. Nós de Recursos
        for (let k in m2dEstado.nosRecursos) {
            const no = m2dEstado.nosRecursos[k];
            const dist = Math.hypot(no.x - j.x, no.y - j.y);
            if (dist <= 2.2 && (no.quantidade > 0 || Date.now() > no.recargaAte)) {
                m2dInteracaoProxima = { tipo: 'recurso', id: k, item: no, prompt: `[E] Extrair ${no.nome}` };
                return;
            }
        }
    }

    function aoPressionarTeclaMundo2D(e) {
        const aba = document.getElementById('aba-mundo2d');
        if (!aba || aba.classList.contains('oculto')) return;
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;

        const k = e.key.toLowerCase();
        if (k === 'w' || e.key === 'ArrowUp') { e.preventDefault(); moverMundo2D(0, -1); }
        else if (k === 's' || e.key === 'ArrowDown') { e.preventDefault(); moverMundo2D(0, 1); }
        else if (k === 'a' || e.key === 'ArrowLeft') { e.preventDefault(); moverMundo2D(-1, 0); }
        else if (k === 'd' || e.key === 'ArrowRight') { e.preventDefault(); moverMundo2D(1, 0); }
        else if (k === ' ' || k === 'spacebar') {
            e.preventDefault();
            executarAcaoPrincipalEspaco();
        } else if (k === 'e') {
            e.preventDefault();
            executarAcaoSecundariaE();
        } else if (k === 't') {
            e.preventDefault();
            document.getElementById('m2d-chat-input')?.focus();
        } else if (k === 'b') {
            e.preventDefault();
            alternarPaletaConstrucao();
        } else if (['1', '2', '3', '4'].includes(k)) {
            e.preventDefault();
            dispararPoderAkashicoHotbar(parseInt(k) - 1);
        }
    }

        function executarAcaoPrincipalEspaco() {
        // Verifica se está próximo do Chefe Mundial Azazel (62, 62)
        if (m2dEstado && m2dEstado.worldBoss && m2dEstado.worldBoss.ativo && meuVampiro && m2dEstado.jogadores && m2dEstado.jogadores[meuVampiro.id]) {
            const j = m2dEstado.jogadores[meuVampiro.id];
            const dist = Math.hypot(j.x - m2dEstado.worldBoss.x, j.y - m2dEstado.worldBoss.y);
            if (dist <= 4.5) {
                atacarBossMundial2D();
                return;
            }
        }
        if (!m2dInteracaoProxima) {
            // Golpe no ar com arma principal
            executarSlashAnimacao();
            return;
        }

        if (m2dInteracaoProxima.tipo === 'monstro') {
            atacarMonstroEmFrente2D(m2dInteracaoProxima.id);
        } else if (m2dInteracaoProxima.tipo === 'recurso') {
            coletarNoEspecifico2D(m2dInteracaoProxima.item.x, m2dInteracaoProxima.item.y);
        } else {
            executarSlashAnimacao();
        }
    }

    function executarAcaoSecundariaE() {
        if (!m2dInteracaoProxima) {
            mostrarNotificacaoMundo2D("Nada próximo para interagir.");
            return;
        }

        if (m2dInteracaoProxima.tipo === 'edificacao') {
            interagirComEdificacaoCidade(m2dInteracaoProxima.item);
        } else if (m2dInteracaoProxima.tipo === 'mortal') {
            morderMortalEmFrente2D(m2dInteracaoProxima.id);
        } else if (m2dInteracaoProxima.tipo === 'recurso') {
            coletarNoEspecifico2D(m2dInteracaoProxima.item.x, m2dInteracaoProxima.item.y);
        } else if (m2dInteracaoProxima.tipo === 'monstro') {
            atacarMonstroEmFrente2D(m2dInteracaoProxima.id);
        }
    }

    function executarSlashAnimacao() {
