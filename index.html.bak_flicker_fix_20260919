let audioContextoProfundo = new (window.AudioContext || window.webkitAudioContext)();

// ==========================================
// SISTEMA TTS SUPREMO EVOLUÍDO
// ==========================================
let ttsSombrioAtivo = true;

function toggleTTS() {
