    function renderizarPassoGuia() {
        document.querySelectorAll('.tut-highlight-active').forEach(e => {
            e.classList.remove('tut-highlight-active');
            if (e.dataset.oldZindex !== undefined) {
                e.style.zIndex = e.dataset.oldZindex;
                delete e.dataset.oldZindex;
            }
        });

        if (listenerAtivo && elementoEmDestaque) { 
            elementoEmDestaque.removeEventListener('click', listenerAtivo); 
            listenerAtivo = null; 
        }
        
        if (passoAtualGuia >= passosGuiaInterativo.length) {
            const floatBox = document.getElementById('tut-guia-floating');
            if (floatBox) floatBox.classList.add('oculto');
            const blocker = document.getElementById('tut-blocker');
            if (blocker) blocker.remove();

            fetch('/api/tutorial/concluido', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id: meuVampiro.id })
            }).then(() => {
                showJuiceNotif("INICIAÇÃO CONCLUÍDA", "+500 Sangue & +100 XP adicionados!");
                if (typeof syncStatus === 'function') syncStatus();
            }).catch(() => {});

            ocultoAlert("O teu treino inicial terminou. As tuas correntes caíram e a Matriz está aberta. Bem-vindo à Ordem.");
            return;
        }

        const passo = passosGuiaInterativo[passoAtualGuia];

        // Navegação automática e garantida até a aba e sub-seção do passo
        if (passo.aba && typeof nav === 'function') {
            nav(passo.aba);
        }
        if (passo.subSec && typeof switchSubSection === 'function') {
            setTimeout(() => {
                switchSubSection(passo.aba, passo.subSec);
            }, 80);
        }

        safeSet('tut-f-title', passo.titulo);
        safeSet('tut-f-text', passo.texto);

        if (passo.onEnter) passo.onEnter();

        const btnAvancar = document.getElementById('tut-f-btn-next');
        if (btnAvancar) {
            btnAvancar.style.display = 'block';
            btnAvancar.innerText = (passoAtualGuia === passosGuiaInterativo.length - 1) ? 'Concluir Iniciação 🌟' : 'Entendido (Avançar) ❯';
        }

        let tentativas = 0;

        function tentarEncontrarEFocar() {
            let el = document.getElementById(passo.alvoId) || document.querySelector(passo.alvoId);
            
            if (el && el.offsetParent !== null) {
                elementoEmDestaque = el;
                el.classList.add('tut-highlight-active');

                // Rolagem suave até o elemento
                el.scrollIntoView({ behavior: "smooth", block: "center" });

                const blocker = document.getElementById('tut-blocker');
                const guiaFloating = document.getElementById('tut-guia-floating');
                if (blocker) document.body.appendChild(blocker);
                if (guiaFloating) document.body.appendChild(guiaFloating);

                // Posicionamento inteligente para nunca cobrir o alvo
                if (guiaFloating) {
                    const rect = el.getBoundingClientRect();
                    if (rect.top > (window.innerHeight * 0.45)) {
                        guiaFloating.style.top = "25px";
                        guiaFloating.style.bottom = "auto";
                    } else {
                        guiaFloating.style.top = "auto";
                        guiaFloating.style.bottom = "25px";
                    }
                }

                if (!passo.executaSozinho) {
                    listenerAtivo = function() {
                        el.removeEventListener('click', listenerAtivo);
                        listenerAtivo = null;
                        setTimeout(proximoPassoGuia, passo.delayProximo || 300); 
                    };
                    el.addEventListener('click', listenerAtivo);
                }
            } else {
                tentativas++;
                if (tentativas < 15) { 
                    setTimeout(tentarEncontrarEFocar, 200);
                } else {
                    if (btnAvancar) btnAvancar.style.display = 'block'; 
                }
            }
        }

        setTimeout(tentarEncontrarEFocar, 150); 
    }

