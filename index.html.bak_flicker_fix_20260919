    window.addEventListener('keydown', function(e) {
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

        // Se tecla Escape for pressionada, fecha modais
        if (e.key === 'Escape') {
            fecharConsciencias();
            fecharSettings();
            fecharMobileDrawer();
            const modalConv = document.getElementById('modal-convite');
            if (modalConv) modalConv.classList.add('oculto');
            return;
        }

        // Se combate ativo, mapeia 1, 2, 3 e Espaço
        const arenaCombate = document.getElementById('arena-acao');
        if (arenaCombate && !arenaCombate.classList.contains('oculto')) {
            if (e.key === '1') { e.preventDefault(); acaoVisceral('ataque'); }
            else if (e.key === '2') { e.preventDefault(); acaoVisceral('defesa'); }
            else if (e.key === '3') { e.preventDefault(); acaoVisceral('magia'); }
            else if (e.key === ' ' || e.code === 'Space') { e.preventDefault(); curarNoCombate(); }
            return;
        }

        // Se estiver na masmorra ativa
        const abaAventura = document.getElementById('aba-aventura');
        const dngArea = document.getElementById('dungeon-game-area');
        if (typeof dngAtiva !== 'undefined' && dngAtiva && abaAventura && !abaAventura.classList.contains('oculto') && dngArea && !dngArea.classList.contains('oculto')) {
            let dx = 0, dy = 0;
            if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') dy = -1;
            else if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') dy = 1;
            else if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') dx = -1;
            else if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') dx = 1;
            if (dx !== 0 || dy !== 0) {
                e.preventDefault();
                if (typeof window.emitDngMove === 'function') window.emitDngMove(dx, dy);
                return;
            }
        }

        // Navegação Rápida Global (8 Territórios & Mapa)
        if (e.key === 'm' || e.key === 'M' || e.key === '0' || e.key === '`') nav('mapa');
        else if (e.key === '1') nav('caca');
        else if (e.key === '2') nav('perfil');
        else if (e.key === '3') nav('oficios');
        else if (e.key === '4') nav('aventura');
        else if (e.key === '5') nav('magia');
        else if (e.key === '6') nav('leilao');
        else if (e.key === '7') nav('chat');
        else if (e.key === '8') nav('clan');
        else if (e.key === 'c' || e.key === 'C') nav('compendio');
        else if (e.key === 'l' || e.key === 'L') nav('astrolabio');
        else if (e.key === 'b' || e.key === 'B') nav('banco');
        else if (e.key === 'o' || e.key === 'O') abrirConsciencias();
    });

