        }

        isSyncing = true; // Trava o combate para evitar spam ou morrer enquanto cura
        document.getElementById('inimigo-status').innerText = "A BEBER SANGUE...";
        document.getElementById('inimigo-status').className = "inimigo-intent intent-sync";

        try {
            // Invoca a Rota de Cura Oculta do Servidor
            const res = await fetch('/api/perfil/curar', { 
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ id: meuVampiro.id }) 
            }); 
            const dados = await res.json(); 
            
            if (dados.erro) {
                quebrarCombo("SEM SANGUE (OURO) PARA CURAR!");
            } else {
                // Sucesso! Busca o status atualizado para sincronizar o HP novo e o Sangue gasto
                const resStatus = await fetch(`/api/status?id=${meuVampiro.id}`);
                const statusDados = await resStatus.json();
                
                if (!statusDados.erro) {
                    meuVampiro = statusDados.vampiro;
                    let curaRealizada = meuVampiro.hpAtual - combateDados.hpAtualJogador;
                    
                    // Injeta a vida regenerada no motor da Arena local
                    combateDados.hpAtualJogador = meuVampiro.hpAtual;
                    
                    // Efeitos Visuais Sombrios (Juice)
