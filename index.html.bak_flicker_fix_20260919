    let ritAtivo = false;
    let ritLoop = null;
    let ritProjetoAtivo = null; 
    
    let ritProgresso = 0;
    let ritProximoNó = 1;
    let ritPressaoAlvo = 50;
    let ritPressaoAtual = 10;
    let ritPressaoIsPouring = false;
    let ritPonteiroRitmoPos = 10;

    let canvasLoop = null;
    let canvasAngulo = 0;
    let particulasSangue = [];

    function iniciarMotorCanvas(tipo) {
        const cvs = document.getElementById('rit-sigil-canvas');
        if (!cvs) return;
        const ctx = cvs.getContext('2d');
        if (canvasLoop) cancelAnimationFrame(canvasLoop);
        
        particulasSangue = [];
        for(let i=0; i<30; i++) particulasSangue.push({ x: Math.random()*cvs.width, y: Math.random()*cvs.height, vel: Math.random()*2+1, raio: Math.random()*2+1 });

        function desenharFrame() {
            if(!ritAtivo) return; 
            
            ctx.clearRect(0, 0, cvs.width, cvs.height);
            canvasAngulo += 0.02; 
            const cx = cvs.width / 2; const cy = cvs.height / 2;

            ctx.save();
            ctx.translate(cx, cy);

            if (tipo === 'trilhagem') {
                ctx.rotate(canvasAngulo * 0.5);
                ctx.beginPath();
                for (let i = 0; i <= 5; i++) {
                    const ang = i * 4 * Math.PI / 5 - Math.PI / 2;
                    if (i === 0) ctx.moveTo(Math.cos(ang)*100, Math.sin(ang)*100);
                    else ctx.lineTo(Math.cos(ang)*100, Math.sin(ang)*100);
                }
                ctx.closePath();
                ctx.strokeStyle = "rgba(255, 30, 47, 0.9)"; ctx.lineWidth = 3;
                ctx.shadowBlur = 20; ctx.shadowColor = "#ff1e2f"; ctx.stroke();
                
                ctx.beginPath(); ctx.arc(0, 0, 115, 0, Math.PI * 2);
                ctx.strokeStyle = "rgba(208, 128, 255, 0.4)"; ctx.lineWidth = 2; ctx.stroke();
            } 
            else if (tipo === 'pressao') {
                ctx.rotate(-canvasAngulo * 1.5);
                for(let i=0; i<8; i++) {
                    ctx.beginPath(); ctx.moveTo(0,0);
                    ctx.quadraticCurveTo(Math.cos(i)*80, Math.sin(i)*80, Math.cos(i+canvasAngulo)*130, Math.sin(i+canvasAngulo)*130);
                    ctx.strokeStyle = "rgba(138, 3, 3, 0.8)"; ctx.lineWidth = 5;
                    ctx.shadowBlur = 15; ctx.shadowColor = "#ff1e2f"; ctx.stroke();
                }
                ctx.beginPath(); ctx.arc(0, 0, 25 + Math.sin(canvasAngulo*10)*10, 0, Math.PI*2);
                ctx.fillStyle = "rgba(255, 30, 47, 0.8)"; ctx.fill();
            } 
            else if (tipo === 'ritmo') {
                const pulso = 1 + Math.sin(canvasAngulo * 12) * 0.15;
                ctx.scale(pulso, pulso);
                
                ctx.beginPath(); ctx.moveTo(0, -20);
                ctx.bezierCurveTo(40, -60, 80, 0, 0, 50); ctx.bezierCurveTo(-80, 0, -40, -60, 0, -20);
                ctx.fillStyle = "rgba(30, 0, 40, 0.9)";
                ctx.shadowBlur = 30; ctx.shadowColor = "#d080ff"; ctx.fill();
                ctx.lineWidth = 3; ctx.strokeStyle = "#d080ff"; ctx.stroke();
                
                ctx.beginPath(); ctx.moveTo(0, -10); ctx.lineTo(0, 40); ctx.moveTo(-20, -10); ctx.lineTo(-10, 20); ctx.moveTo(20, -10); ctx.lineTo(10, 20);
                ctx.strokeStyle = "rgba(255, 30, 47, 0.5)"; ctx.stroke();
            } 
            else {
                for(let i=1; i<=3; i++) {
                    ctx.beginPath();
                    ctx.arc(0, 0, 35 * i, canvasAngulo*i, Math.PI + canvasAngulo*i);
                    ctx.strokeStyle = `rgba(0, 255, 85, ${1 - (i*0.2)})`; 
                    ctx.lineWidth = 6; ctx.shadowBlur = 15; ctx.shadowColor = "#0f5"; ctx.stroke();
                }
            }
            ctx.restore();

            ctx.fillStyle = "rgba(255, 30, 47, 0.7)";
            particulasSangue.forEach(p => {
                ctx.beginPath(); ctx.arc(p.x, p.y, p.raio, 0, Math.PI*2); ctx.fill();
                p.y += p.vel; 
                if(p.y > cvs.height) { p.y = 0; p.x = Math.random() * cvs.width; }
            });

            canvasLoop = requestAnimationFrame(desenharFrame);
        }
        desenharFrame();
    }

