async function canalizarMatrizIAClient() {
    if (!meuVampiro) return ocultoAlert("Precisas estar logado.");
    if (!_matrizTradicaoSelecionada) return ocultoAlert("Seleciona uma Tradição Ancestral (Passo 1).");
    
    const intencao = document.getElementById('matriz-intencao-input')?.value?.trim();
    if (!intencao || intencao.length < 10) return ocultoAlert("Descreve a tua intenção mágica com pelo menos 10 caracteres (Passo 2).");
    
    const vinculoTipo = document.getElementById('matriz-vinculo-select')?.value || 'ressonancia';
    
    const btn = document.getElementById('btn-canalizar-matriz');
    if (btn) {
        btn.disabled = true;
        btn.innerText = '🌀 A Consciência está a canalizar...';
        btn.style.opacity = '0.6';
    }
    
    try {
        const res = await fetch('/api/ordem/canalizar_matriz_ia', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ id: meuVampiro.id, tradicao: _matrizTradicaoSelecionada, intencao, vinculoTipo })
        });
        const d = await res.json();
        
        if (d.sucesso) {
            ocultoAlert("✨ " + (d.relato || "Nó canalizado com sucesso na Matriz!"));
            
            // Mostrar resultado visual
            const resPanel = document.getElementById('matriz-resultado-ia');
            if (resPanel && d.no) {
                resPanel.classList.remove('oculto');
                const sigilo = document.getElementById('matriz-res-sigilo');
                const nome = document.getElementById('matriz-res-nome');
                const trad = document.getElementById('matriz-res-tradicao');
                const desc = document.getElementById('matriz-res-descricao');
                const efeito = document.getElementById('matriz-res-efeito');
                const gnose = document.getElementById('matriz-res-gnose');
                
                if (sigilo) sigilo.innerText = d.no.sigilo || '✨';
                if (nome) nome.innerText = d.no.nome || 'Nó Arcano';
                if (trad) trad.innerText = `Tradição: ${_matrizTradicaoSelecionada.charAt(0).toUpperCase() + _matrizTradicaoSelecionada.slice(1)} | Vínculo: ${vinculoTipo.replace(/_/g, ' ')}`;
                if (desc) desc.innerText = d.no.descricao || d.no.descricaoEsoterica || '';
                if (efeito) efeito.innerText = `⚡ Efeito: ${JSON.stringify(d.no.efeitoAutoritativo || d.no.efeito || {})}`;
                if (gnose) gnose.innerText = d.gnoseGanha ? `+${d.gnoseGanha} Gnose recebida` : '';
                
                resPanel.style.animation = 'fadeIn 0.5s ease';
            }
            
            // Limpar campos
            document.getElementById('matriz-intencao-input').value = '';
            _matrizTradicaoSelecionada = null;
            document.querySelectorAll('.matriz-trad-btn').forEach(b => {
                b.style.borderColor = '#3b0764';
                b.style.background = '#0a0618';
                b.style.boxShadow = 'none';
            });
            
        } else {
            ocultoAlert("⚠️ " + (d.erro || "Falha ao canalizar."));
        }
    } catch(e) { 
        ocultoAlert("Erro de conexão ao canalizar na Matriz."); 
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerText = '✨ Canalizar com a Consciência da Ordem ✨';
            btn.style.opacity = '1';
        }
    }
}

async function carregarNosMatriz() {
