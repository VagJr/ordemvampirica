    function initCirculoMagicoCanvas() {
        const cvs = document.getElementById('canvas-circulo-magico');
        if (!cvs) return;
        const ctx = cvs.getContext('2d');
        if (!ctx) return;

        function renderFrame() {
            const w = cvs.width;
            const h = cvs.height;
            const cx = w / 2;
            const cy = h / 2;

            ctx.clearRect(0, 0, w, h);

            const grad = ctx.createRadialGradient(cx, cy, 10, cx, cy, cx);
            grad.addColorStop(0, '#160205');
            grad.addColorStop(0.7, '#070103');
            grad.addColorStop(1, '#020001');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, w, h);

            // Anel Externo (Clavicula Salomonis)
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(circuloRotAngle);

            ctx.strokeStyle = `rgba(212, 175, 55, ${0.4 + circuloGlowAlpha * 0.4})`;
            ctx.lineWidth = 2;
            ctx.shadowColor = '#ff1e2f';
            ctx.shadowBlur = 10 * circuloGlowAlpha;

            ctx.beginPath();
            ctx.arc(0, 0, 145, 0, Math.PI * 2);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(0, 0, 130, 0, Math.PI * 2);
            ctx.stroke();

            const letras = ['א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז', 'ח', 'ט', 'י', 'כ', 'ל', 'מ', 'נ', 'ס', 'ע', 'פ', 'צ', 'ק', 'ר', 'ש', 'ת', '☉', '☽', '♂', '☿', '♃', '♀', '♄', '🜍', '🜞', '🜘'];
            ctx.font = '11px serif';
            ctx.fillStyle = `rgba(255, 215, 0, ${0.6 + circuloGlowAlpha * 0.4})`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            for (let i = 0; i < letras.length; i++) {
                const th = (i / letras.length) * Math.PI * 2;
                const rx = Math.cos(th) * 137.5;
                const ry = Math.sin(th) * 137.5;
                ctx.save();
                ctx.translate(rx, ry);
                ctx.rotate(th + Math.PI / 2);
                ctx.fillText(letras[i], 0, 0);
                ctx.restore();
            }
            ctx.restore();

            // Anel Médio com Rotação Oposta (Heptagrama de Salomão)
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(-circuloRotAngle * 1.5);

            ctx.strokeStyle = `rgba(255, 30, 47, ${0.45 + circuloGlowAlpha * 0.5})`;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(0, 0, 108, 0, Math.PI * 2);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(0, 0, 82, 0, Math.PI * 2);
            ctx.stroke();

            const heptRadius = 108;
            ctx.beginPath();
            for (let k = 0; k < 7; k++) {
                const step = (k * 3) % 7;
                const angle = (step / 7) * Math.PI * 2 - Math.PI / 2;
                const hx = Math.cos(angle) * heptRadius;
                const hy = Math.sin(angle) * heptRadius;
                if (k === 0) ctx.moveTo(hx, hy);
                else ctx.lineTo(hx, hy);
            }
            ctx.closePath();
            ctx.stroke();
            ctx.restore();

            // Núcleo Interior: Selo Duplo Hexagrama & Pulso de Sangue
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(circuloRotAngle * 0.8);

            ctx.strokeStyle = `rgba(212, 175, 55, ${0.6 + circuloGlowAlpha * 0.4})`;
            ctx.lineWidth = 1.5;

            ctx.beginPath();
            for (let t = 0; t < 3; t++) {
                const an = (t / 3) * Math.PI * 2 - Math.PI / 2;
                const tx = Math.cos(an) * 58;
                const ty = Math.sin(an) * 58;
                if (t === 0) ctx.moveTo(tx, ty);
                else ctx.lineTo(tx, ty);
            }
            ctx.closePath();
            ctx.stroke();

            ctx.beginPath();
            for (let t = 0; t < 3; t++) {
                const an = (t / 3) * Math.PI * 2 + Math.PI / 2;
                const tx = Math.cos(an) * 58;
                const ty = Math.sin(an) * 58;
                if (t === 0) ctx.moveTo(tx, ty);
                else ctx.lineTo(tx, ty);
            }
            ctx.closePath();
            ctx.stroke();

            const pulse = Math.sin(Date.now() * 0.004) * 4;
            const radCore = 20 + pulse + (circuloGlowAlpha * 8);
            const gradCore = ctx.createRadialGradient(0, 0, 2, 0, 0, radCore);
            gradCore.addColorStop(0, '#ff1e2f');
            gradCore.addColorStop(0.5, '#8a0303');
            gradCore.addColorStop(1, 'rgba(30, 2, 5, 0)');
            ctx.fillStyle = gradCore;
            ctx.beginPath();
            ctx.arc(0, 0, radCore, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();

            circuloRotAngle += circuloRotVelocidade;
            if (circuloGlowAlpha > 0.3) circuloGlowAlpha -= 0.008;
            if (circuloRotVelocidade > 0.006) circuloRotVelocidade -= 0.0004;

            circuloAnimId = requestAnimationFrame(renderFrame);
        }

        if (circuloAnimId) cancelAnimationFrame(circuloAnimId);
        circuloAnimId = requestAnimationFrame(renderFrame);
    }

