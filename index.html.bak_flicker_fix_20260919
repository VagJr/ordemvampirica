            spawnDanoText(`-${Math.floor(dados.dano)} (${dados.atacante})`, "#d4af37");
            
            // Efeito visual dependendo se o aliado usou magia ou ataque (inferido pelo contexto)
            if (dados.magiaVisual) spawnMagicEffect(cX, cY, dados.magiaVisual.cor, dados.magiaVisual.icone);
            else spawnBloodSplatter(cX, cY);

            const bossSprite = document.getElementById('inimigo-icone');
