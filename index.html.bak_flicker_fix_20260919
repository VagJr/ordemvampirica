    function renderizarLogsGlobais() {
        const lista = window.todosLogsGlobais || [];
        const f = window.filtroProfeciasAtual || 'todos';
        let filtrados = lista;
        if (f === 'mestre') {
            filtrados = lista.filter(l => (l.tipo && (l.tipo.includes('MESTRE') || l.tipo.includes('ORÁCULO') || l.tipo.includes('SELO'))) || (l.relato && l.relato.includes('Mestre')));
        } else if (f === 'ritual') {
            filtrados = lista.filter(l => (l.tipo && (l.tipo.includes('RITUAL') || l.tipo.includes('SACRIFÍCIO') || l.tipo.includes('ALQUIMIA') || l.tipo.includes('DESPERTAR'))));
        } else if (f === 'guerra') {
            filtrados = lista.filter(l => (l.tipo && (l.tipo.includes('GUERRA') || l.tipo.includes('FENDA') || l.tipo.includes('CONCLAVE') || l.tipo.includes('COMBATE'))));
        } else if (f === 'balanca') {
            filtrados = lista.filter(l => (l.tipo && (l.tipo.includes('BALANÇA') || l.tipo.includes('ORDEM') || l.tipo.includes('INQUISIÇÃO'))));
        }
        safeSet('log-global', filtrados.map(l => `<div class="log-item"><span class="log-tipo">[${l.tipo}]</span> <span class="log-texto">${l.relato}</span></div>`).join(''), true);
    }

    let presaFocoAtual = null;

    async function abrirPresaMercado(hash) {
        if (!hash) return;
        try {
            const res = await fetch('/api/mercado');
            const dados = await res.json();
            let m = (dados.mortais || []).find(x => x.hash === hash);

            // Se não localizou nos mortais do rebanho aberto, verifica se é uma vítima registrada do jogador
            if (!m && meuVampiro && meuVampiro.alvosNosferatu) {
                const v = meuVampiro.alvosNosferatu.find(a => a.alvoId === hash || a.nomeAstral.toLowerCase() === hash.toLowerCase());
                if (v) {
                    m = {
                        hash: v.alvoId,
                        id: v.nomeAstral,
                        plataforma: v.urlPerfil ? 'OSINT' : (v.instagram ? 'Instagram' : 'OSINT'),
                        hp: v.sangueHp || 2500,
                        hpMax: 2500,
                        estado: v.estadoAstral || 'Vibrante',
                        qualidade: `${v.arquetipoAbissal || 'Presa Registrada'} [${v.ressonanciaElemental || 'Éter'}]`,
                        leituraAura: v.analiseIA || 'Alma desvelada pelo Olhar de Nosferatu.',
                        donoSelo: meuVampiro.nome,
                        dadosOsint: v
                    };
                }
            }

            if (!m) return;
            hashAlvoAtual = hash;
            presaFocoAtual = m;

            const elDoc = document.getElementById('mortal-doc');
            const elSem = document.getElementById('sem-presa-msg');
            if (elDoc) elDoc.style.display = 'block';
            if (elSem) elSem.style.display = 'none';

            if (typeof switchSubSection === 'function') switchSubSection('caca', 'presa');

            safeSet('doc-hash', `SIGILO ASTRAL: ${m.hash}`);
            safeSet('doc-id', m.id);
            safeSet('doc-rede', (m.plataforma || 'HUMANO').toUpperCase());
            safeSet('doc-qualidade', m.qualidade || 'Comum');
            safeSet('doc-aura', m.leituraAura || 'Sem leituras perceptíveis.');

            // Vitalidade e Barra Visual Animada
            const hpAtual = m.estado === 'Limbo' ? 0 : (m.hp ?? 2500);
            const hpMax = m.hpMax || 2500;
            const pctHp = Math.max(0, Math.min(100, Math.round((hpAtual / hpMax) * 100)));
            safeSet('doc-hp', numFmt(hpAtual));
            safeSet('doc-hp-val', `${numFmt(hpAtual)} / ${numFmt(hpMax)} HP (${pctHp}%)`);
            const barEl = document.getElementById('doc-hp-bar');
            if (barEl) {
                barEl.style.width = `${pctHp}%`;
                if (pctHp <= 20) barEl.style.background = '#ff0000';
                else if (pctHp <= 50) barEl.style.background = 'linear-gradient(90deg, #d97706, #ef4444)';
                else barEl.style.background = 'linear-gradient(90deg, #8a0303 0%, #ff1e2f 100%)';
            }

            // Badge de Estado Astral
            const badgeEl = document.getElementById('doc-status-badge');
            if (badgeEl) {
                badgeEl.innerText = m.estado || 'Vibrante';
                if (m.estado === 'Limbo') {
                    badgeEl.style.background = '#2a0505'; badgeEl.style.borderColor = '#ff1e2f'; badgeEl.style.color = '#ff5555';
                } else if (m.estado === 'No Leilao') {
                    badgeEl.style.background = '#2a1a05'; badgeEl.style.borderColor = 'var(--ouro)'; badgeEl.style.color = 'var(--ouro)';
                } else {
                    badgeEl.style.background = '#052a10'; badgeEl.style.borderColor = '#0f5'; badgeEl.style.color = '#0f5';
                }
            }

            // Métricas / Qualidades do Alvo (se tiver dados OSINT)
            const osint = m.dadosOsint || {};
            safeSet('doc-karma', osint.pesoKarmico ?? 'Neutro');
            safeSet('doc-alma', osint.essencia || 'Mundana');
            safeSet('doc-ressonancia', osint.ressonanciaElemental || 'Éter');
            safeSet('doc-hz', (osint.frequenciaVibracionalHz ? `${osint.frequenciaVibracionalHz} Hz` : '528 Hz'));
            safeSet('doc-polaridade', osint.polaridadeAlma || 'Neutra');
            safeSet('doc-vaso', (osint.vasoInfluencia ? `${osint.vasoInfluencia}%` : '50%'));

            // Vínculo / Domínio
            const statusEl = document.getElementById('doc-status-extra');
            if (statusEl) {
                if (m.donoSelo) {
                    statusEl.innerHTML = `🔒 <strong>Vínculo:</strong> Marcado por <span style="color:var(--ouro);">${m.donoSelo}</span>`;
                } else {
                    statusEl.innerHTML = `🔓 <strong>Vínculo:</strong> <span style="color:#0f5;">Alma Livre (Sem dono)</span>`;
                }
            }

            // Botão Drenar
            const btnDrenar = document.getElementById('btn-drenar');
            if (btnDrenar) {
                if (m.estado === 'Limbo') {
                    btnDrenar.innerText = "ALMA NO LIMBO"; btnDrenar.disabled = true;
                } else if (m.estado === 'No Leilao') {
                    btnDrenar.innerText = "SELADO EM LEILÃO"; btnDrenar.disabled = true;
                } else {
                    btnDrenar.innerText = "🩸 Executar Acto"; btnDrenar.disabled = false;
                }
            }

            // Botão Absolver
            const btnAbsolver = document.getElementById('btn-absolver');
            if (btnAbsolver) {
                if (meuVampiro && (meuVampiro.geracao === 1 || meuVampiro.admin)) btnAbsolver.classList.remove('oculto');
                else btnAbsolver.classList.add('oculto');
            }

            // Atualizar o seletor com o item atual
            const seletor = document.getElementById('seletor-trocar-presa');
            if (seletor && seletor.value !== hash) {
                seletor.value = hash;
            }

            if (elDoc) elDoc.scrollIntoView({ behavior: "smooth" });
        } catch(e) {
            console.warn("Erro ao abrir presa:", e);
        }
    }

