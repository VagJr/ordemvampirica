        if (perc <= 0.1) iconEl.className = "inimigo-sprite boss-phase-4"; else if (perc <= 0.3) iconEl.className = "inimigo-sprite boss-phase-3"; else if (perc <= 0.6) iconEl.className = "inimigo-sprite boss-phase-2"; else iconEl.className = "inimigo-sprite";
