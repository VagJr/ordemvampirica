function usarHabilidadeCustom(habilidadeId) {
        if(!combateAtivo || isSyncing) return;
        const hab = meuVampiro.habilidadesAtivas.find(h => h.id === habilidadeId);
        if(!hab) return;

        if(meuVampiro.calice < hab.custoGts) return quebrarCombo(`Falta Gts no Cálice (${hab.custoGts})!`);
        
        // Empacota os dados para a Cloud processar!
        meuVampiro.calice -= hab.custoGts;
        combateDados.estatisticas.sangueGastoMagia += hab.custoGts;
        
        let multiplier = 1 + (combateDados.comboAtual * 0.1);
        let poderAplicado = Math.floor(hab.poderBase * multiplier);

        if(hab.tipo === 'dano') {
		spawnMagicEffect(cX, cY, hab.cor_hex || "#ff1e2f", hab.icone || "🔥");
            combateDados.hpAtualInimigo -= poderAplicado;
            combateDados.estatisticas.danoCausado += poderAplicado;
            combateDados.comboAtual = 0; // Descarrega combo
            spawnDanoText(poderAplicado, "#ff1e2f");
            playSfx('magia'); abismoVoid();
            safeSet('arena-feedback', `${hab.nome} ESTILHAÇOU O INIMIGO!`); document.getElementById('arena-feedback').style.color = "#ff1e2f";
        } 
        else if (hab.tipo === 'cura') {
            combateDados.hpAtualJogador = Math.min(combateDados.hpMaxJogador, combateDados.hpAtualJogador + poderAplicado);
            combateDados.estatisticas.curaRuptura += poderAplicado; // Aproveita a var já existente
            spawnDanoText(`+${poderAplicado}`, "#0f5");
            playSfx('levelup'); jorrarSangue();
            safeSet('arena-feedback', `${hab.nome} REGENEROU A CARNE!`); document.getElementById('arena-feedback').style.color = "#0f5";
        }
        else if (hab.tipo === 'buff' || hab.tipo === 'debuff') {
            combateDados.estadoInimigo = 'vulneravel';
            combateDados.timerAcaoInimigo = 30; // Paralisa o boss
            playSfx('espada');
            safeSet('arena-feedback', `${hab.nome} PARALISOU A ENTIDADE!`); document.getElementById('arena-feedback').style.color = "#d080ff";
        }

        if (combateDados.hpAtualInimigo <= 0) processarCicloComServidor(false); 
        else { atualizarBarras(); atualizarFaseProceduralBoss(); }
    }
