    function gerarAvatarSombrio(seedNome, isBoss = false) {
        let hash = 0; for (let i = 0; i < seedNome.length; i++) { hash = seedNome.charCodeAt(i) + ((hash << 5) - hash); }
        const r = Math.abs(hash % 200) + 55; const g = Math.abs((hash * 2) % 50); const b = Math.abs((hash * 3) % 100);
        const corBase = `rgb(${r}, ${g}, ${b})`; const corSec = `rgb(${Math.abs((hash*5)%255)}, 0, 0)`;
        const lados = (Math.abs(hash) % 4) + 3; 
        const scale = isBoss ? "scale(1.2)" : "scale(1)";
        
        let poly = ""; const centro = 50; const raio = 40;
        for(let i=0; i<lados; i++) { let angle = (i * 2 * Math.PI) / lados; poly += `${centro + raio * Math.cos(angle)},${centro + raio * Math.sin(angle)} `; }

        return `<svg viewBox="0 0 100 100" style="width:100%; height:100%; filter: drop-shadow(0 0 15px ${corBase}); transform: ${scale};">
                  <polygon points="${poly.trim()}" fill="#050000" stroke="${corBase}" stroke-width="3" />
                  <circle cx="50" cy="50" r="${Math.abs(hash % 15) + 10}" fill="${corSec}" stroke="${corBase}" stroke-width="2" />
                  <path d="M30,50 Q50,70 70,50" fill="none" stroke="${corSec}" stroke-width="4" opacity="${isBoss ? 1 : 0}" />
                </svg>`;
    }
    
