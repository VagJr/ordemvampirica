        /* Elementos Viscerais do Combate */
        .claw-splash { position: fixed; top: 0; left: 0; pointer-events: none; width: 100vw; height: 100vh; background: radial-gradient(circle, transparent 40%, rgba(212, 175, 55, 0.4) 100%); z-index: 9999; animation: splashFade 1.0s forwards; border-left: 5px solid var(--seth-ouro); border-right: 5px solid var(--seth-ouro);}
        .blood-splash { position: fixed; top: 0; left: 0; pointer-events: none; width: 100vw; height: 100vh; background: radial-gradient(circle, transparent 20%, rgba(138, 3, 3, 0.9) 100%); z-index: 9999; animation: splashFade 1.5s forwards; }
        @keyframes splashFade { 0% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.1); } }
        
        .radio-container { display: flex; justify-content: space-around; margin: 15px 0; }
        .radio-btn { display: none; }
        .radio-label { padding: 10px; border: 1px solid #333; cursor: pointer; color: #888; font-family: 'Cinzel', serif; transition: 0.3s; flex: 1; text-align: center; margin: 0 5px; border-radius: 3px;}
        #raca-vampiro:checked + .radio-label { border-color: var(--sangue); color: var(--sangue-claro); background: #2a0000; box-shadow: 0 0 10px var(--sangue);}
        #raca-lycan:checked + .radio-label { border-color: var(--seth-ouro); color: var(--seth-ouro); background: #221a00; box-shadow: 0 0 10px var(--seth-ouro);}
        .tema-lycan { --sangue: #b8860b; --sangue-claro: #ffd700; border-top-color: var(--seth-ouro) !important; }

        .disclaimer-box { background: #160204; border: 1px solid #6b0c14; color: #f3cccc; padding: 15px; font-size: 0.85em; margin-bottom: 20px; box-shadow: 0 0 15px rgba(255,0,0,0.25); border-radius: 4px; }
        .disclaimer-box strong { font-family: 'Cinzel', serif; font-size: 1.15em; display:block; margin-bottom: 5px; color: #ff3333;}
        .veu-box { display: none !important; }

        /* Calice de Sangue Gótico & Animado */
        .calice-wrapper { position: relative; width: 140px; height: 160px; margin: 15px auto 0 auto; }
        .calice-vidro { position: absolute; top:0; left:0; width: 100%; height: 100%; border: 3px solid var(--ouro); border-radius: 6px 6px 60px 60px; z-index: 10; pointer-events: none; box-shadow: inset 0 0 25px rgba(255,30,47,0.4), 0 0 15px rgba(212,175,55,0.4); border-top: 2px solid var(--ouro); }
        .calice-conteudo { position: absolute; bottom:0; left:0; width: 100%; height: 100%; border-radius: 6px 6px 60px 60px; overflow: hidden; background: radial-gradient(circle at 50% 100%, #200206 0%, #060102 100%); }
        .liquido-fill { position: absolute; bottom: 0; left: 0; width: 100%; height: 10%; background: linear-gradient(to bottom, #ff3344 0%, #aa0515 50%, #4a0006 100%); transition: height 1.2s cubic-bezier(0.4, 0, 0.2, 1); z-index: 5; box-shadow: 0 0 25px rgba(255, 30, 47, 0.7); }
        .liquido-wave { position: absolute; top: -16px; left: 0; width: 300%; height: 32px; background: rgba(255, 60, 80, 0.85); filter: blur(1px); border-radius: 42%; animation: waveFlow 3.5s ease-in-out infinite alternate, waveMove 6s linear infinite; z-index: 6; }
        .liquido-wave::before { content: ""; position: absolute; top: -8px; left: -40%; width: 100%; height: 100%; background: rgba(180, 10, 25, 0.75); border-radius: 38%; animation: waveFlow 4.5s ease-in-out infinite alternate-reverse, waveMoveReverse 5s linear infinite; }
        .calice-stem { width: 18px; height: 35px; background: linear-gradient(90deg, #6e5510, var(--ouro), #503d08); margin: 0 auto; border: 1px solid #332205; border-radius: 2px; }
        .calice-base { width: 90px; height: 12px; background: linear-gradient(180deg, var(--ouro) 0%, #5a4510 100%); margin: 0 auto; border-radius: 8px 8px 3px 3px; box-shadow: 0 4px 10px rgba(0,0,0,0.8); }
        @keyframes waveFlow { 0% { transform: scaleY(0.8) translateY(3px); } 100% { transform: scaleY(1.2) translateY(-3px); } }
        @keyframes waveMove { from { transform: translateX(-10%); } to { transform: translateX(-50%); } }
        @keyframes waveMoveReverse { from { transform: translateX(-50%); } to { transform: translateX(10%); } }

        .progress-bg { background: #0c0406; height: 12px; width: 100%; border-radius: 2px; margin-top: 5px; overflow: hidden; border: 1px solid #301015; position: relative;}
        .progress-bar { background: linear-gradient(90deg, #2b4570 0%, var(--xp) 100%); height: 100%; width: 0%; transition: width 0.5s; box-shadow: 0 0 10px var(--xp);}
        .progress-text { position: absolute; width: 100%; text-align: center; top: -2px; font-size: 0.72em; color: #fff; font-weight: bold; text-shadow: 1px 1px 0 #000; z-index: 2;}

        /* =================================================== */
        /* ARENA DE COMBATE VISCERAL - ZERO SCROLL E ATMOSFERA */
        /* =================================================== */
        /* Durante qualquer combate, ocultar totalmente as barras de navegação e cabeçalhos */
        body.em-combate #mobile-bottom-nav,
        body.em-combate #quick-realm-strip,
        body.em-combate .world-ticker,
        body.em-combate #desktop-hud,
        body.em-combate #mobile-drawer,
        body.em-combate #mobile-drawer-overlay,
        #arena-acao:not(.oculto) ~ #mobile-bottom-nav,
