                        <span style="background: rgba(56, 189, 248, 0.15); border: 1px solid #0284c7; color: #7dd3fc; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem;">${p}</span>
                    `).join('');
                }
                
                resContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
