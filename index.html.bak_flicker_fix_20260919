    // ==========================================
    // CLIQUE NO CANVAS: MOVIMENTO, ATAQUE OU CONSTRUÇÃO
    // ==========================================
    async function aoClicarCanvasMundo2D(e) {
        if (!m2dCanvas || !m2dEstado || !meuVampiro) return;
        const rect = m2dCanvas.getBoundingClientRect();
        const scaleX = m2dCanvas.width / rect.width;
        const scaleY = m2dCanvas.height / rect.height;

        const mouseX = (e.clientX - rect.left) * scaleX;
        const mouseY = (e.clientY - rect.top) * scaleY;

        const centroTelaX = m2dCanvas.width / 2;
        const centroTelaY = m2dCanvas.height / 2;

        const tileX = Math.floor((mouseX - centroTelaX) / m2dTileSize + m2dCamera.x);
        const tileY = Math.floor((mouseY - centroTelaY) / m2dTileSize + m2dCamera.y);

        if (tileX < 0 || tileY < 0 || tileX >= m2dEstado.largura || tileY >= m2dEstado.altura) return;

        // Se clicou no botão de interação proxima prompt
        if (m2dInteracaoProxima && mouseY > m2dCanvas.height - 70 && mouseY < m2dCanvas.height - 30) {
            executarAcaoSecundariaE();
            return;
        }

        // Modo Demolição
        if (m2dModoDemolir) {
            let estEncontrada = null;
            for (let id in m2dEstado.estruturas) {
                const est = m2dEstado.estruturas[id];
                if (est.x === tileX && est.y === tileY) { estEncontrada = est; break; }
            }
            if (estEncontrada) {
                if (confirm(`Desmantelar estrutura [${estEncontrada.nome}] em (${tileX}, ${tileY})?`)) {
                    try {
                        const res = await fetch('/api/mundo2d/demolir', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: meuVampiro.id, estruturaId: estEncontrada.id })
                        });
                        const d = await res.json();
                        if (d.erro) return mostrarNotificacaoMundo2D(d.erro);
                        delete m2dEstado.estruturas[estEncontrada.id];
                        mostrarNotificacaoMundo2D(d.relato);
                    } catch(e) {}
                }
            }
            return;
        }

        const j = m2dEstado.jogadores[meuVampiro.id];
        if (!j) return;
        const dist = Math.hypot(j.x - tileX, j.y - tileY);

        // Se clicou em Monstro próximo -> ataca
        for (let id in m2dEstado.monstros) {
            const m = m2dEstado.monstros[id];
            if (m.x === tileX && m.y === tileY && dist <= 2.5) {
                atacarMonstroEmFrente2D(id);
                return;
            }
        }

        // Se clicou em Mortal próximo -> morde
        for (let id in m2dEstado.mortais) {
            const m = m2dEstado.mortais[id];
            if (m.x === tileX && m.y === tileY && dist <= 2.5) {
                morderMortalEmFrente2D(id);
                return;
            }
        }

        // Se clicou em Edificação próxima -> interage
        const edifs = m2dEstado.edificacoesCidade || {};
        for (let id in edifs) {
            const ed = edifs[id];
            if (ed.x === tileX && ed.y === tileY && dist <= 2.5) {
                interagirComEdificacaoCidade(ed);
                return;
            }
        }

        // Se clicou em Nó de recurso próximo -> colhe
        const chaveRec = `${tileX}_${tileY}`;
        if (m2dEstado.nosRecursos[chaveRec] && dist <= 2.5) {
            coletarNoEspecifico2D(tileX, tileY);
            return;
        }

        // Se clicou em tile adjacente com bloco selecionado -> constrói
        if (dist > 0 && dist <= 2.5 && m2dBlocoSelecionado) {
            try {
                const res = await fetch('/api/mundo2d/construir', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: meuVampiro.id, tipoEstrutura: m2dBlocoSelecionado, x: tileX, y: tileY })
                });
                const d = await res.json();
                if (d.erro) {
                    mostrarNotificacaoMundo2D(d.erro);
                } else {
                    playSfx('magia');
                    mostrarNotificacaoMundo2D(d.relato);
                    m2dEstado.estruturas[d.estrutura.id] = d.estrutura;
                    adicionarParticulas(tileX, tileY, '#d4af37', 15);
                    syncStatus();
                }
                return;
            } catch(e) {}
        }

        // Caso contrário, caminha
        const dx = Math.sign(tileX - j.x);
        const dy = Math.sign(tileY - j.y);
        moverMundo2D(dx, dy);
    }

