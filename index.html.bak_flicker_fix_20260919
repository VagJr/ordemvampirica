    // ==========================================
    // COMBATE VISCERAL & MORDIDA EM TEMPO REAL NO 2D
    // ==========================================
    async function atacarMonstroEmFrente2D(mobId) {
        if (!meuVampiro || !m2dEstado) return;
        const agora = Date.now();
        if (agora - m2dUltimoAtaque < 300) return; // Cooldown rápido
        m2dUltimoAtaque = agora;

        try {
            const res = await fetch('/api/mundo2d/atacar_mob', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: meuVampiro.id, mobId })
            });
            const dados = await res.json();
            if (dados.erro) return mostrarNotificacaoMundo2D(dados.erro);

            playSfx('espada');
            const mob = m2dEstado.monstros[mobId];
            if (mob) {
                adicionarParticulas(mob.x, mob.y, '#f00', 12);
                adicionarTextoFlutuante(`-${dados.danoCausado} HP${dados.isCrit ? ' 💥 CRIT!' : ''}`, mob.x, mob.y - 0.4, dados.isCrit ? '#ffd700' : '#ff4757');
                if (dados.curaDreno > 0) {
                    adicionarTextoFlutuante(`+${dados.curaDreno} HP`, mob.x, mob.y - 0.8, '#2ed573');
                }
            }

            mostrarNotificacaoMundo2D(dados.relato);
            if (dados.mobMorto) {
                delete m2dEstado.monstros[mobId];
                if (dados.recompensa) {
                    adicionarTextoFlutuante(`+${dados.recompensa.xp} XP | +${dados.recompensa.gts} Gts`, m2dCamera.x, m2dCamera.y - 1, '#26de81');
                }
            } else if (mob) {
                mob.hp = dados.mobHp;
            }

            if (dados.hpAtual !== undefined) meuVampiro.hpAtual = dados.hpAtual;
            if (dados.sangueTotal !== undefined) meuVampiro.sangue = dados.sangueTotal;
            syncUI();
            verificarProximidadeMundo2D();
        } catch(e) {}
    }

    async function morderMortalEmFrente2D(mortalId) {
        if (!meuVampiro || !m2dEstado) return;
        try {
            const res = await fetch('/api/mundo2d/morder_mortal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: meuVampiro.id, mortalId })
            });
            const dados = await res.json();
            if (dados.erro) return mostrarNotificacaoMundo2D(dados.erro);

            playSfx('sangue');
            const mortal = m2dEstado.mortais[mortalId];
            if (mortal) {
