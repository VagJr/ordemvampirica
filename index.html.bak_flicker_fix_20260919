    // ==========================================
    // RENDER LOOP & ENGINE GRÁFICA DO CANVAS 2D
    // ==========================================
    function renderLoopMundo2D() {
        if (!m2dCanvas || !m2dCtx) {
            requestAnimationFrame(renderLoopMundo2D);
            return;
        }

        const aba = document.getElementById('aba-mundo2d');
        if (!aba || aba.classList.contains('oculto')) {
            setTimeout(() => requestAnimationFrame(renderLoopMundo2D), 300);
            return;
        }

        desenharQuadroMundo2D();
        requestAnimationFrame(renderLoopMundo2D);
    }

    function desenharQuadroMundo2D() {
        const ctx = m2dCtx;
        const w = m2dCanvas.width;
        const h = m2dCanvas.height;

        ctx.fillStyle = '#050204';
        ctx.fillRect(0, 0, w, h);

        if (!m2dEstado || !m2dEstado.grid) {
            ctx.fillStyle = '#888';
            ctx.font = '14px Cinzel, serif';
            ctx.textAlign = 'center';
            ctx.fillText('A sintonizar frequências do Mundo 2D...', w / 2, h / 2);
            return;
        }

        const centroX = w / 2;
        const centroY = h / 2;
        const tileSize = m2dTileSize;

        const camX = m2dCamera.x;
        const camY = m2dCamera.y;

        const minTileX = Math.max(0, Math.floor(camX - (centroX / tileSize) - 1));
        const maxTileX = Math.min(m2dEstado.largura - 1, Math.ceil(camX + (centroX / tileSize) + 1));
        const minTileY = Math.max(0, Math.floor(camY - (centroY / tileSize) - 1));
        const maxTileY = Math.min(m2dEstado.altura - 1, Math.ceil(camY + (centroY / tileSize) + 1));

        // 1. DESENHAR TERRENO DO GRID COM TEXTURA RICA
        for (let y = minTileY; y <= maxTileY; y++) {
            for (let x = minTileX; x <= maxTileX; x++) {
                const screenX = centroX + (x - camX) * tileSize;
                const screenY = centroY + (y - camY) * tileSize;
                const tipo = m2dEstado.grid[y][x];

                if (tipo === 1) {
                    // Santuário de Enoch (Calçamento Nobre)
                    ctx.fillStyle = (x + y) % 2 === 0 ? '#1e1c29' : '#171520';
                    ctx.fillRect(screenX, screenY, tileSize, tileSize);
                    ctx.strokeStyle = '#2d2840';
                    ctx.strokeRect(screenX, screenY, tileSize, tileSize);
                } else if (tipo === 2) {
                    // Floresta de Espinhos (Terra escura com raízes)
                    ctx.fillStyle = (x + y) % 2 === 0 ? '#0d1f14' : '#08170d';
                    ctx.fillRect(screenX, screenY, tileSize, tileSize);
                    ctx.strokeStyle = '#14381e';
                    ctx.strokeRect(screenX, screenY, tileSize, tileSize);
                } else if (tipo === 3) {
                    // Ermos de Gehenna (Cinzas vulcânicas & veios de lava)
                    ctx.fillStyle = (x + y) % 2 === 0 ? '#26090b' : '#1c0507';
                    ctx.fillRect(screenX, screenY, tileSize, tileSize);
                    ctx.strokeStyle = '#420f13';
                    ctx.strokeRect(screenX, screenY, tileSize, tileSize);
                } else if (tipo === 4) {
                    // Cordilheira de Obsidiana (Rochas negras com reflexos)
                    ctx.fillStyle = (x + y) % 2 === 0 ? '#222226' : '#17171a';
                    ctx.fillRect(screenX, screenY, tileSize, tileSize);
                    ctx.strokeStyle = '#35353d';
                    ctx.strokeRect(screenX, screenY, tileSize, tileSize);
                } else {
                    ctx.fillStyle = '#020002';
                    ctx.fillRect(screenX, screenY, tileSize, tileSize);
                }
            }
        }

        // 2. DESENHAR EDIFICAÇÕES DA CIDADE (SANTUÁRIO DE ENOCH)
        const edifs = m2dEstado.edificacoesCidade || {};
        for (let id in edifs) {
            const ed = edifs[id];
            if (ed.x < minTileX || ed.x > maxTileX || ed.y < minTileY || ed.y > maxTileY) continue;
            const screenX = centroX + (ed.x - camX) * tileSize;
            const screenY = centroY + (ed.y - camY) * tileSize;

            // Halo iluminado da edificação
            const pulse = Math.sin(Date.now() * 0.003) * 3;
            ctx.beginPath();
            ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize * 0.8 + pulse, 0, Math.PI * 2);
            ctx.fillStyle = `${ed.cor || '#ffd700'}22`;
            ctx.fill();

            // Bloco estilizado da construção
            ctx.fillStyle = 'rgba(25, 10, 18, 0.9)';
            ctx.fillRect(screenX - 2, screenY - 2, tileSize + 4, tileSize + 4);
            ctx.strokeStyle = ed.cor || 'var(--ouro)';
            ctx.lineWidth = 2;
            ctx.strokeRect(screenX - 2, screenY - 2, tileSize + 4, tileSize + 4);

            // Ícone da edificação
            ctx.font = '22px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(ed.icone || '🏛️', screenX + tileSize / 2, screenY + tileSize / 2 + 7);

            // Nome e Subtítulo
            ctx.fillStyle = ed.cor || '#ffd700';
            ctx.font = 'bold 9px Cinzel, serif';
            ctx.fillText(ed.nome.split(' ')[0], screenX + tileSize / 2, screenY - 4);
        }

        // 3. DESENHAR NÓS DE RECURSOS
        for (let k in m2dEstado.nosRecursos) {
            const no = m2dEstado.nosRecursos[k];
            if (no.x < minTileX || no.x > maxTileX || no.y < minTileY || no.y > maxTileY) continue;
            const screenX = centroX + (no.x - camX) * tileSize;
            const screenY = centroY + (no.y - camY) * tileSize;

            ctx.font = '18px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(no.icone || '🌿', screenX + tileSize / 2, screenY + tileSize / 2 + 6);

            if (no.quantidade > 0) {
                ctx.fillStyle = '#0f5';
                ctx.font = 'bold 9px sans-serif';
                ctx.fillText(no.quantidade, screenX + tileSize - 3, screenY + 9);
            }
        }

        // 4. DESENHAR ESTRUTURAS DE CLÃ (SANDBOX MINECRAFT-STYLE)
        for (let id in m2dEstado.estruturas) {
            const est = m2dEstado.estruturas[id];
            if (est.x < minTileX || est.x > maxTileX || est.y < minTileY || est.y > maxTileY) continue;
            const screenX = centroX + (est.x - camX) * tileSize;
            const screenY = centroY + (est.y - camY) * tileSize;

            ctx.fillStyle = 'rgba(55, 12, 18, 0.85)';
            ctx.fillRect(screenX + 2, screenY + 2, tileSize - 4, tileSize - 4);
            ctx.strokeStyle = '#d4af37';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(screenX + 2, screenY + 2, tileSize - 4, tileSize - 4);

            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(est.icone || '🧱', screenX + tileSize / 2, screenY + tileSize / 2 + 5);

            ctx.fillStyle = '#ffd700';
            ctx.font = '8px sans-serif';
            ctx.fillText((est.clanNome || 'Clã').substring(0, 8), screenX + tileSize / 2, screenY - 2);
        }

        // 5. DESENHAR MONSTROS DO ABISMO
        for (let id in m2dEstado.monstros) {
            const mob = m2dEstado.monstros[id];
            if (mob.x < minTileX || mob.x > maxTileX || mob.y < minTileY || mob.y > maxTileY) continue;
            const screenX = centroX + (mob.x - camX) * tileSize;
            const screenY = centroY + (mob.y - camY) * tileSize;

            ctx.font = '18px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(mob.icone || '🦇', screenX + tileSize / 2, screenY + tileSize / 2 + 6);

            const hpPct = Math.max(0, mob.hp / mob.hpMax);
            ctx.fillStyle = '#300';
            ctx.fillRect(screenX + 4, screenY - 4, tileSize - 8, 3);
            ctx.fillStyle = '#f00';
            ctx.fillRect(screenX + 4, screenY - 4, (tileSize - 8) * hpPct, 3);
        }

        
        // 5.5 DESENHAR CHEFE MUNDIAL AZAZEL NOS ERMOS DE GEHENNA (62, 62)
        const wb = m2dEstado.worldBoss;
        if (wb && wb.ativo) {
            const screenX = centroX + (wb.x - camX) * tileSize;
            const screenY = centroY + (wb.y - camY) * tileSize;
            if (wb.x >= minTileX - 2 && wb.x <= maxTileX + 2 && wb.y >= minTileY - 2 && wb.y <= maxTileY + 2) {
                const pulse = Math.sin(Date.now() * 0.005) * 8;
                ctx.beginPath();
                ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize * 1.6 + pulse, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255, 23, 68, 0.28)';
                ctx.fill();

                ctx.font = '36px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('👹', screenX + tileSize / 2, screenY + tileSize / 2 + 12);

                const hpPct = Math.max(0, wb.hp / wb.hpMax);
                ctx.fillStyle = '#1c0205';
                ctx.fillRect(screenX - tileSize, screenY - 20, tileSize * 3, 8);
                ctx.fillStyle = '#ff1744';
                ctx.fillRect(screenX - tileSize, screenY - 20, (tileSize * 3) * hpPct, 8);
                ctx.strokeStyle = '#ffd700';
                ctx.lineWidth = 1;
                ctx.strokeRect(screenX - tileSize, screenY - 20, tileSize * 3, 8);

                ctx.fillStyle = '#ffd700';
                ctx.font = 'bold 9px Cinzel, serif';
                ctx.fillText(`[CHEFE MUNDIAL] AZAZEL (${wb.hp}/${wb.hpMax})`, screenX + tileSize / 2, screenY - 24);
            }
        }

        // 6. DESENHAR MORTAIS / VÍTIMAS VAGANDO
        for (let id in m2dEstado.mortais) {
            const m = m2dEstado.mortais[id];
            if (m.x < minTileX || m.x > maxTileX || m.y < minTileY || m.y > maxTileY) continue;
            const screenX = centroX + (m.x - camX) * tileSize;
            const screenY = centroY + (m.y - camY) * tileSize;

            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(m.icone || '🧑‍💼', screenX + tileSize / 2, screenY + tileSize / 2 + 5);

            ctx.fillStyle = '#ff7979';
            ctx.font = '8px sans-serif';
            ctx.fillText((m.nome || 'Mortal').split(' ')[0], screenX + tileSize / 2, screenY - 2);
        }

        // 7. DESENHAR SERVOS DO REINO (MINIONS VIVOS)
        for (let id in m2dEstado.minions) {
            const m = m2dEstado.minions[id];
            if (m.x < minTileX || m.x > maxTileX || m.y < minTileY || m.y > maxTileY) continue;
            const screenX = centroX + (m.x - camX) * tileSize;
            const screenY = centroY + (m.y - camY) * tileSize;

            ctx.beginPath();
            ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize / 2 - 2, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(38, 222, 129, 0.25)';
            ctx.fill();

            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(m.icone || '🤖', screenX + tileSize / 2, screenY + tileSize / 2 + 5);

            // Speech bubble rápida do minion
            ctx.fillStyle = '#26de81';
            ctx.font = '8px sans-serif';
            ctx.fillText(m.nome.split(' ')[0], screenX + tileSize / 2, screenY - 2);
        }

        // 8. DESENHAR OUTROS JOGADORES ONLINE
        for (let id in m2dEstado.jogadores) {
            if (meuVampiro && id === meuVampiro.id) continue;
            const j = m2dEstado.jogadores[id];
            if (j.x < minTileX || j.x > maxTileX || j.y < minTileY || j.y > maxTileY) continue;
            const screenX = centroX + (j.x - camX) * tileSize;
            const screenY = centroY + (j.y - camY) * tileSize;

            const isMatilha = comitivaAtualCache && comitivaAtualCache.membros && comitivaAtualCache.membros.some(m => m.id === id);
            if (isMatilha) {
                ctx.beginPath();
                ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize / 2 + 3, 0, Math.PI * 2);
                ctx.strokeStyle = '#00e5ff';
                ctx.lineWidth = 2;
                ctx.stroke();
            }

            ctx.beginPath();
            ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize / 2 - 2, 0, Math.PI * 2);
            ctx.fillStyle = isMatilha ? '#00b4d8' : (j.cor || '#ff3838');
            ctx.fill();

            ctx.font = '16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(j.icone || '🧛', screenX + tileSize / 2, screenY + tileSize / 2 + 5);

            ctx.fillStyle = isMatilha ? '#00e5ff' : '#fff';
            ctx.font = isMatilha ? 'bold 9px Cinzel, serif' : '9px Cinzel, serif';
            ctx.fillText((isMatilha ? '🐺 ' : '') + j.nome, screenX + tileSize / 2, screenY - 3);
        }

        // 9. DESENHAR JOGADOR LOCAL COM ILUMINAÇÃO DE LANTERNA
        if (meuVampiro && m2dEstado.jogadores[meuVampiro.id]) {
            const j = m2dEstado.jogadores[meuVampiro.id];
            const screenX = centroX + (j.x - camX) * tileSize;
            const screenY = centroY + (j.y - camY) * tileSize;

            // Halo pulsante de glória e vitae
            ctx.beginPath();
            ctx.arc(screenX + tileSize / 2, screenY + tileSize / 2, tileSize / 2 + 3, 0, Math.PI * 2);
            ctx.strokeStyle = '#ffd700';
            ctx.lineWidth = 2.5;
            ctx.stroke();

            // Sprite do Avatar
            ctx.font = '20px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(meuVampiro.raca === 'lycan' ? '🐺' : '🧛', screenX + tileSize / 2, screenY + tileSize / 2 + 7);

            // Nome e Barra de HP acima da cabeça
            ctx.fillStyle = '#ffd700';
            ctx.font = 'bold 11px Cinzel, serif';
            ctx.fillText(meuVampiro.nome, screenX + tileSize / 2, screenY - 7);

            const hpRatio = Math.max(0, (meuVampiro.hpAtual || 0) / (meuVampiro.hpMax || 1000));
            ctx.fillStyle = '#400';
            ctx.fillRect(screenX - 4, screenY - 5, tileSize + 8, 3);
            ctx.fillStyle = '#0f5';
            ctx.fillRect(screenX - 4, screenY - 5, (tileSize + 8) * hpRatio, 3);
        }

        // 10. EFEITOS ESPECIAIS: SLASH ARCS & ONDAS AKÁSHICAS
        if (m2dSlashVfx) {
            m2dSlashVfx.frame++;
            const sx = centroX + (m2dSlashVfx.x - camX) * tileSize;
            const sy = centroY + (m2dSlashVfx.y - camY) * tileSize;
            ctx.save();
            ctx.beginPath();
            ctx.arc(sx, sy, tileSize * (0.8 + m2dSlashVfx.frame * 0.2), -0.5, 1.5);
            ctx.strokeStyle = '#ff793f';
            ctx.lineWidth = 4;
            ctx.stroke();
            ctx.restore();
            if (m2dSlashVfx.frame > 5) m2dSlashVfx = null;
        }

        if (m2dAreaVfx) {
            m2dAreaVfx.frame++;
            const ax = centroX + (m2dAreaVfx.x - camX) * tileSize;
            const ay = centroY + (m2dAreaVfx.y - camY) * tileSize;
            ctx.save();
            ctx.beginPath();
            ctx.arc(ax, ay, m2dAreaVfx.raio * tileSize * (m2dAreaVfx.frame / 15), 0, Math.PI * 2);
            ctx.strokeStyle = m2dAreaVfx.cor || '#9b59b6';
            ctx.lineWidth = 3;
            ctx.stroke();
            ctx.restore();
            if (m2dAreaVfx.frame > 15) m2dAreaVfx = null;
        }

        // 11. PARTÍCULAS E TEXTOS FLUTUANTES
        for (let i = m2dParticulas.length - 1; i >= 0; i--) {
            const p = m2dParticulas[i];
            p.x += p.vx * 0.1;
            p.y += p.vy * 0.1;
            p.vida -= p.decaimento;
            if (p.vida <= 0) {
                m2dParticulas.splice(i, 1);
                continue;
            }
            const px = centroX + (p.x - camX) * tileSize;
            const py = centroY + (p.y - camY) * tileSize;
            ctx.beginPath();
            ctx.arc(px, py, p.tamanho, 0, Math.PI * 2);
            ctx.fillStyle = p.cor;
            ctx.globalAlpha = p.vida;
            ctx.fill();
            ctx.globalAlpha = 1.0;
        }

        for (let i = m2dTextosFlutuantes.length - 1; i >= 0; i--) {
            const tf = m2dTextosFlutuantes[i];
            tf.y += tf.vy * 0.05;
            tf.progresso++;
            if (tf.progresso >= tf.duracao) {
                m2dTextosFlutuantes.splice(i, 1);
                continue;
            }
            const tx = centroX + (tf.x - camX) * tileSize;
            const ty = centroY + (tf.y - camY) * tileSize;
            ctx.font = 'bold 12px Cinzel, sans-serif';
            ctx.fillStyle = tf.cor;
            ctx.textAlign = 'center';
            ctx.fillText(tf.txt, tx, ty);
        }

        // 11.5. DESENHAR BALÕES DE PROXIMIDADE 2D NO CANVAS
        const agoraFala = Date.now();
        for (let i = baloesFala2D.length - 1; i >= 0; i--) {
            const b = baloesFala2D[i];
            if (agoraFala > b.expiraEm) {
                baloesFala2D.splice(i, 1);
                continue;
            }
            let bx = b.x;
            let by = b.y;
            if (m2dEstado && m2dEstado.jogadores && m2dEstado.jogadores[b.jogadorId]) {
                bx = m2dEstado.jogadores[b.jogadorId].x;
                by = m2dEstado.jogadores[b.jogadorId].y;
            }
            const sx = centroX + (bx - camX) * tileSize + tileSize / 2;
            const sy = centroY + (by - camY) * tileSize - 20;

            ctx.save();
            ctx.font = '10px sans-serif';
            const textWidth = ctx.measureText(b.texto).width;
            const bubbleWidth = Math.min(220, Math.max(70, textWidth + 16));
            const bubbleHeight = 22;
            const bubbleX = sx - bubbleWidth / 2;
            const bubbleY = sy - bubbleHeight;

            ctx.fillStyle = 'rgba(12, 2, 6, 0.94)';
            ctx.strokeStyle = '#00e5ff';
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            if (ctx.roundRect) ctx.roundRect(bubbleX, bubbleY, bubbleWidth, bubbleHeight, 5);
            else ctx.rect(bubbleX, bubbleY, bubbleWidth, bubbleHeight);
            ctx.fill();
            ctx.stroke();

            // Cauda do balão
            ctx.beginPath();
            ctx.moveTo(sx - 4, bubbleY + bubbleHeight);
            ctx.lineTo(sx, bubbleY + bubbleHeight + 4);
            ctx.lineTo(sx + 4, bubbleY + bubbleHeight);
            ctx.closePath();
            ctx.fillStyle = 'rgba(12, 2, 6, 0.94)';
            ctx.fill();
            ctx.strokeStyle = '#00e5ff';
            ctx.stroke();

            ctx.fillStyle = '#fff';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            let txtCortado = b.texto;
            if (txtCortado.length > 30) txtCortado = txtCortado.substring(0, 28) + '...';
            ctx.fillText(txtCortado, sx, bubbleY + bubbleHeight / 2);
            ctx.restore();
        }

        // 12. ILUMINAÇÃO RADIAL DINÂMICA (FOG OF WAR / LANTERNA)
        const radLantern = 240;
        const gradLuz = ctx.createRadialGradient(centroX, centroY, 40, centroX, centroY, radLantern);
        gradLuz.addColorStop(0, 'rgba(0, 0, 0, 0)');
        gradLuz.addColorStop(0.7, 'rgba(0, 0, 0, 0.25)');
        gradLuz.addColorStop(1, 'rgba(0, 0, 0, 0.7)');
        ctx.fillStyle = gradLuz;
        ctx.fillRect(0, 0, w, h);

        // 13. HUD DA INTERAÇÃO PRÓXIMA (PROMPT NO CENTRO INFERIOR)
        if (m2dInteracaoProxima) {
            const promptY = h - 65;
            ctx.save();
            ctx.fillStyle = 'rgba(10, 2, 4, 0.92)';
            ctx.strokeStyle = '#ffd700';
            ctx.lineWidth = 1.5;
            ctx.fillRect(centroX - 160, promptY, 320, 28);
            ctx.strokeRect(centroX - 160, promptY, 320, 28);

            ctx.fillStyle = '#ffd700';
            ctx.font = 'bold 11px Cinzel, serif';
            ctx.textAlign = 'center';
            ctx.fillText(m2dInteracaoProxima.prompt, centroX, promptY + 18);
            ctx.restore();
        }

        // 14. HOTBAR DE AÇÕES RÁPIDAS (RODAPÉ DO CANVAS)
        const hotbarY = h - 28;
        ctx.save();
        ctx.fillStyle = 'rgba(5, 2, 3, 0.9)';
        ctx.fillRect(0, hotbarY, w, 28);
        ctx.strokeStyle = '#331518';
        ctx.lineWidth = 1;
        ctx.strokeRect(0, hotbarY, w, 28);

        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#aaa';
        ctx.fillText('[Espaço] ⚔️ Atacar  |  [E] 🩸 Interagir/Drenar  |  [1-4] 🌀 Poderes  |  [B] 🧱 Construir', centroX, hotbarY + 18);
        ctx.restore();

        // 15. MINI-MAPA RADAR (CANTO SUPERIOR DIREITO)
        const miniSize = 85;
        const miniX = w - miniSize - 8;
        const miniY = 8;

        ctx.fillStyle = 'rgba(0, 0, 0, 0.82)';
        ctx.fillRect(miniX, miniY, miniSize, miniSize);
        ctx.strokeStyle = '#d4af37';
        ctx.lineWidth = 1;
        ctx.strokeRect(miniX, miniY, miniSize, miniSize);

        const escMin = miniSize / m2dEstado.largura;

        // Santuário Central
        ctx.fillStyle = 'rgba(0, 229, 255, 0.25)';
        ctx.fillRect(miniX + 32 * escMin, miniY + 32 * escMin, 16 * escMin, 16 * escMin);

        // Pontos de Monstros (Vermelho)
        ctx.fillStyle = '#ff1744';
        for (let id in m2dEstado.monstros) {
            const m = m2dEstado.monstros[id];
            ctx.fillRect(miniX + m.x * escMin, miniY + m.y * escMin, 2, 2);
        }

        // Pontos de Mortais (Rosa)
        ctx.fillStyle = '#ff9ff3';
        for (let id in m2dEstado.mortais) {
            const m = m2dEstado.mortais[id];
            ctx.fillRect(miniX + m.x * escMin, miniY + m.y * escMin, 2, 2);
        }

        // Pontos de Minions (Verde)
        ctx.fillStyle = '#26de81';
        for (let id in m2dEstado.minions) {
            const m = m2dEstado.minions[id];
            ctx.fillRect(miniX + m.x * escMin, miniY + m.y * escMin, 2, 2);
        }

        // Ponto do Jogador (Ouro)
        if (meuVampiro && m2dEstado.jogadores[meuVampiro.id]) {
            const j = m2dEstado.jogadores[meuVampiro.id];
            ctx.fillStyle = '#ffd700';
            ctx.fillRect(miniX + j.x * escMin - 1, miniY + j.y * escMin - 1, 4, 4);
        }
    }


