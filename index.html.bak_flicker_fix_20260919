    async function usarPoderAkashicoArena(habilidadeId) {
        if (!combateAtivo || isSyncing) return;
        const hab = (meuVampiro.habilidadesAtivas || []).find(h => h.id === habilidadeId);
        if (!hab) return;

        if (meuVampiro.pontosAcao < (hab.custoFuria || 2)) {
            quebrarCombo(`FÚRIA INSUFICIENTE PARA ${hab.nome.toUpperCase()}!`);
            return;
        }
        if (meuVampiro.sangue < (hab.custoGts || 50)) {
            quebrarCombo(`VITAE INSUFICIENTE PARA ${hab.nome.toUpperCase()}!`);
            return;
        }

        isSyncing = true;
        try {
            const res = await fetch('/api/combate/usar_habilidade_akashica', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: meuVampiro.id, habilidadeId })
            });
            const dados = await res.json();
            if (dados.erro) {
                quebrarCombo(dados.erro);
            } else {
                meuVampiro.pontosAcao = dados.furiaRestante;
                meuVampiro.sangue = dados.sangueRestante;
                meuVampiro.hpAtual = dados.hpAtual;

                playSfx('magia');
                abismoVoid();
                document.getElementById('arena-acao').classList.add('shake-screen');
                setTimeout(() => document.getElementById('arena-acao').classList.remove('shake-screen'), 350);

                if (dados.dano) {
                    let danoFinal = dados.dano * (1 + combateDados.comboAtual * 0.1);
                    if (combateDados.estadoInimigo === 'vulneravel') danoFinal *= 2.5;
                    combateDados.hpAtualInimigo = Math.max(0, combateDados.hpAtualInimigo - danoFinal);
                    spawnDanoText(`-${Math.floor(danoFinal)} 🔮`, '#a855f7');
                    combateDados.comboAtual++;
                    combateDados.maxCombo = Math.max(combateDados.maxCombo, combateDados.comboAtual);
                }

                if (dados.cura) {
                    combateDados.hpAtualJogador = Math.min(combateDados.hpMaxJogador, combateDados.hpAtualJogador + dados.cura);
                    spawnDanoText(`+${dados.cura} 🩸`, '#0f5');
                    jorrarSangue();
                }

                if (dados.atordoamento) {
                    combateDados.timerAcaoInimigo = 60;
                    combateDados.estadoInimigo = 'vulneravel';
                    safeSet('inimigo-status', 'PARALISADO PELO VAZIO');
                    document.getElementById('inimigo-status').className = 'inimigo-intent intent-vulneravel';
                }

                safeSet('arena-feedback', dados.relato);
                document.getElementById('arena-feedback').style.color = '#26de81';
                atualizarBarras();

                if (combateDados.hpAtualInimigo <= 0) {
                    setTimeout(() => encerrarArenaFinal(`🏆 VITÓRIA AKÁSHICA!
${meuVampiro.nome} destruiu o inimigo com o poder de [${hab.nome}]!`), 400);
                }
            }
        } catch(e) {
            quebrarCombo("FALHA NA CANALIZAÇÃO AKÁSHICA!");
        } finally {
            isSyncing = false;
            renderizarHabilidadesArena();
        }
    }

