                    safeSet('arena-feedback', "CARNE REGENERADA!");
                    document.getElementById('arena-feedback').style.color = "#0f5";
                    
                    // Atualiza a barra de HP da Arena e o HUD do jogo
                    atualizarBarras();
                    syncUI(); 
                }
            }
        } catch(e) {
            quebrarCombo("A CONEXÃO COM O CÁLICE FALHOU!");
        } finally {
            isSyncing = false; // Liberta a Arena para o boss voltar a bater
        }
    }

    function acaoVisceral(tipoAcao) {
        if(!combateAtivo || isSyncing) return;
        const state = combateDados; 
        const iconeRect = document.getElementById('inimigo-icone').getBoundingClientRect(); 
        const cX = (iconeRect.width/2) + (Math.random()*40-20); 
        const cY = (iconeRect.height/2) + (Math.random()*40-20);
        
        const atr = meuVampiro.atributosTotais || meuVampiro.atributos;
        
        // CORREÇÃO 1: Evitar o '?. ' que crasha em telemóveis antigos
        const maestriaLaminas = (meuVampiro.maestria && meuVampiro.maestria.laminas) ? meuVampiro.maestria.laminas.nivel : 1;
        const maestriaOcultismo = (meuVampiro.maestria && meuVampiro.maestria.ocultismo) ? meuVampiro.maestria.ocultismo.nivel : 1;
        
        let danoFisico = (atr.vontade * 15) + (meuVampiro.nivel * 5) * maestriaLaminas; 
        let danoMagico = (atr.gnose * 25) + (meuVampiro.nivel * 10) * maestriaOcultismo;
        let multiplicador = 1 + (state.comboAtual * 0.1); 
        
        if (state.estadoInimigo === 'vulneravel') multiplicador *= 3;

        if (tipoAcao === 'defesa') { 
            if (state.estadoInimigo === 'prep_ataque' && state.timerAcaoInimigo <= 6) { 
                state.estadoInimigo = 'vulneravel'; state.timerAcaoInimigo = 20; state.estatisticas.parries++; 
                const flash = document.createElement('div'); flash.className = 'parry-flash'; document.body.appendChild(flash); setTimeout(()=>flash.remove(), 300); 
                playSfx('espada'); spawnDanoText("PARRY!", "#ccc"); 
                safeSet('arena-feedback', "CONTRA-ATAQUE! (ATAQUE OU DISSIPE!)"); document.getElementById('arena-feedback').style.color = "#0f5"; 
            } else { 
                quebrarCombo("DEFESA FALHOU"); 
            } 
            return; 
        }

        if (tipoAcao === 'magia') { 
            let custoMagia = Math.floor((meuVampiro.nivel * 5) + (danoMagico * 0.05));
            if (meuVampiro.calice < custoMagia) {
                return quebrarCombo(`CÁLICE VAZIO! Requer ${custoMagia} Gts.`);
            }
            meuVampiro.calice -= custoMagia;
            safeSet('ui-calice-txt', numFmt(meuVampiro.calice)); 
            state.estatisticas.sangueGastoMagia += custoMagia;   

            if (state.estadoInimigo === 'vulneravel') {
                let danoRuptura = Math.floor(danoMagico * (state.comboAtual || 1) * 3.5); 
                let rouboVital = Math.floor(danoRuptura * 0.15); 

                state.hpAtualInimigo -= danoRuptura;
                state.hpAtualJogador = Math.min(state.hpMaxJogador, state.hpAtualJogador + rouboVital);
                state.estatisticas.danoCausado += danoRuptura;
                state.estatisticas.magiasDealt++;
                state.estatisticas.curaRuptura += rouboVital; 

                state.estadoInimigo = 'idle';
                state.comboAtual = 0; 

                playSfx('levelup'); abismoVoid();
                spawnDanoText("RUPTURA!", "#fff"); spawnDanoText(danoRuptura, "#d080ff");
                safeSet('arena-feedback', `ALMA DEVORADA! (+${Math.floor(rouboVital)} HP)`);
                document.getElementById('arena-feedback').style.color = "#d080ff";
                document.getElementById('arena-acao').classList.add('shake-screen');
                setTimeout(() => document.getElementById('arena-acao').classList.remove('shake-screen'), 500);
            }
            else if (state.estadoInimigo === 'prep_magia' && state.timerAcaoInimigo <= 8) { 
                let danoCausar = Math.floor(danoMagico * multiplicador * 2); 
                state.hpAtualInimigo -= danoCausar; state.estatisticas.danoCausado += danoCausar; state.estatisticas.magiasDealt++; state.estadoInimigo = 'idle'; 
                playSfx('magia'); abismoVoid(); spawnDanoText(danoCausar, "#d080ff"); 
                safeSet('arena-feedback', `DISSIPADO! (-${custoMagia} Gts)`); document.getElementById('arena-feedback').style.color = "#d080ff"; 
            } 
            else { 
                state.hpAtualJogador -= 50; let danoCausar = Math.floor(danoMagico * multiplicador); 
                state.hpAtualInimigo -= danoCausar; state.estatisticas.danoCausado += danoCausar; state.estatisticas.magiasDealt++; 
                playSfx('magia'); spawnDanoText(danoCausar, "#d080ff"); 
            } 
            spawnMagicEffect(cX, cY, "#d080ff", "🔮"); 
        }

        if (tipoAcao === 'ataque') { 
            if (state.estadoInimigo === 'prep_magia') return quebrarCombo("MAGIA IMUNE A LÂMINA!"); 
            let danoCausar = Math.floor(danoFisico * multiplicador); 
            state.hpAtualInimigo -= danoCausar; state.estatisticas.danoCausado += danoCausar; state.estatisticas.ataquesDealt++; 
            state.comboAtual++; if(state.comboAtual > state.maxCombo) state.maxCombo = state.comboAtual; 
            
            playSfx('espada'); 
            spawnBloodSplatter(cX, cY); 
            if(Math.random() > 0.7) spawnFleshChunk(cX, cY); 
            spawnDanoText(danoCausar, "#fff"); 
            
            document.getElementById('inimigo-icone').style.filter = `blur(${Math.min(5, state.comboAtual * 0.5)}px) hue-rotate(${state.comboAtual * 10}deg)`;
        }
        
        if (state.hpAtualInimigo <= 0 || state.hpAtualJogador <= 0) {
            if (state.hpAtualInimigo <= 0) document.getElementById('inimigo-icone').classList.add('boss-death-explode');
            processarCicloComServidor(false); 
        } else { 
            atualizarBarras(); 
            atualizarFaseProceduralBoss(); 
        }
    }
        
       

    function atualizarFaseProceduralBoss() {
