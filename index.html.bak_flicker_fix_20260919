    async function startDungeon() {
        if(!meuVampiro) return;
        const selPartyEl = document.getElementById('dng-party-alvo');
        const selParty = selPartyEl ? selPartyEl.value : "";

        try {
            const res = await fetch('/api/dungeon/iniciar', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ id: meuVampiro.id, tipo: 'solo_coop' })
            });
            const dados = await res.json();
            if(dados.erro) return; // Se usares alertas customizados, coloca aqui

            dngAtiva = dados.estado;
            document.querySelectorAll('.aba').forEach(el => el.classList.add('oculto'));
            document.getElementById('aba-aventura').classList.remove('oculto');
            
            const lobby = document.getElementById('dungeon-lobby');
            if(lobby) lobby.classList.add('oculto');
            
            const gameArea = document.getElementById('dungeon-game-area');
            if(gameArea) { gameArea.classList.remove('oculto'); gameArea.focus(); }
            
            socket.emit('dungeon_join', { dungeonId: dngAtiva.id });
            dngLog(`A tua alma desceu ao Abismo.`, '#0f5');
            renderDungeon();

            // DISPARA O CONVITE SE SELECIONASTE ALGUÉM
            if (selParty !== "") {
                socket.emit('enviar_convite', {
                    de: meuVampiro.id, para: selParty, tipo: 'Masmorra do Abismo',
                    extra: { dungeonId: dngAtiva.id, partyId: dados.partyId }
                });
                dngLog(`Chamado Astral enviado! A aguardar aliados...`, '#d4af37');
            }
        } catch(e) { }
