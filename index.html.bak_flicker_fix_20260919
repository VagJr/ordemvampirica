            for (let id in webrtcConexoes) webrtcConexoes[id].close();
            webrtcConexoes = {};
            
            document.querySelectorAll('audio.voip-player').forEach(a => a.remove());
            
            voipAtivo = false;
            btn.innerText = "🎤 Rádio OFF";
            btn.style.color = "#555"; btn.style.borderColor = "#555";
            return;
        }

        try {
            // Ligar o Microfone (EXIGE HTTPS NO MOBILE!)
            streamLocal = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
            voipAtivo = true;
            btn.innerText = "🎙️ Rádio ON (Clã)";
            btn.style.color = "#0f5"; btn.style.borderColor = "#0f5";
            showJuiceNotif("RÁDIO LIGADO", "O teu canal telepático com o Clã está aberto.");
            
            socket.emit('voip_join', { clan: meuVampiro.clan, id: meuVampiro.id });
        } catch (e) {
            ocultoAlert("O feitiço falhou! Verifica se o jogo está a correr em HTTPS e se deste permissão ao microfone.");
            console.error("Erro de Microfone:", e);
        }
    }

    function criarConexaoWebRTC(targetId, isCaller) {
        const pc = new RTCPeerConnection(configIce);
        webrtcConexoes[targetId] = pc;

        // Adiciona a nossa voz à chamada
        streamLocal.getTracks().forEach(track => pc.addTrack(track, streamLocal));

        // Quando recebemos a voz do outro jogador
        pc.ontrack = (event) => {
            let audioEl = document.getElementById(`audio_${targetId}`);
            if (!audioEl) {
                audioEl = document.createElement('audio');
                audioEl.id = `audio_${targetId}`;
                audioEl.className = 'voip-player';
                audioEl.autoplay = true;
                audioEl.playsInline = true; // [CORREÇÃO MOBILE CRÍTICA] Sem isto o Safari recusa tocar áudio WebRTC
                document.body.appendChild(audioEl);
            }
            audioEl.srcObject = event.streams[0];
        };

        pc.onicecandidate = (event) => {
            if (event.candidate) {
                socket.emit('webrtc_ice_candidate', { target: targetId, candidate: event.candidate });
            }
        };

        if (isCaller) {
            pc.createOffer().then(offer => {
                return pc.setLocalDescription(offer);
            }).then(() => {
                socket.emit('webrtc_offer', { target: targetId, sdp: pc.localDescription });
            });
        }
        return pc;
    }

    // Ouve quando alguém liga o rádio
    socket.on('voip_user_joined', (dados) => {
        if (!voipAtivo) return;
        showJuiceNotif("ECO ASTRAL", `[${dados.nome}] entrou na frequência do Clã.`);
        criarConexaoWebRTC(dados.socketId, true);
    });

    // Ouve a resposta para conectar o áudio
    socket.on('webrtc_offer', async (dados) => {
        if (!voipAtivo) return;
        const pc = criarConexaoWebRTC(dados.caller, false);
        await pc.setRemoteDescription(new RTCSessionDescription(dados.sdp));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        socket.emit('webrtc_answer', { target: dados.caller, sdp: pc.localDescription });
    });

    socket.on('webrtc_answer', (dados) => {
        const pc = webrtcConexoes[dados.caller];
        if (pc) pc.setRemoteDescription(new RTCSessionDescription(dados.sdp));
    });

    socket.on('webrtc_ice_candidate', (dados) => {
        const pc = webrtcConexoes[dados.caller];
        if (pc) pc.addIceCandidate(new RTCIceCandidate(dados.candidate));
    });

    socket.on('voip_user_left', (dados) => {
        if (webrtcConexoes[dados.socketId]) {
            webrtcConexoes[dados.socketId].close();
            delete webrtcConexoes[dados.socketId];
        }
        const audioEl = document.getElementById(`audio_${dados.socketId}`);
        if (audioEl) audioEl.remove();
    });


