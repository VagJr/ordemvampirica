// ==========================================
// REVERB
// ==========================================
function gerarEcoCaverna(ctx) {
    let length = ctx.sampleRate * 3;
    let impulse = ctx.createBuffer(2, length, ctx.sampleRate);

    for (let i = 0; i < length; i++) {
        let n = i / length;
        let decay = Math.pow(1 - n, 4);
        impulse.getChannelData(0)[i] = (Math.random() * 2 - 1) * decay;
        impulse.getChannelData(1)[i] = (Math.random() * 2 - 1) * decay;
    }

    let convolver = ctx.createConvolver();
    convolver.buffer = impulse;
    return convolver;
}

// ==========================================
// DISTORÇÃO
// ==========================================
function gerarCurvaDistorcao(amount) {
    let k = amount || 20;
    let n_samples = 44100;
    let curve = new Float32Array(n_samples);
    let deg = Math.PI / 180;

    for (let i = 0; i < n_samples; ++i) {
        let x = i * 2 / n_samples - 1;
        curve[i] = (3 + k) * x * 15 * deg / (Math.PI + k * Math.abs(x));
    }

    return curve;
}
// ==========================================
// VOZ SOBRENATURAL DA AKASHA — PIPELINE VAMPÍRICO
// ==========================================
// Pipeline: Fonte → 3 Camadas (Principal + Sussurro + Eco) →
//   Pitch Shift → Chorus (LFO) → Distorção Demoníaca →
//   Reverb Catacumba (4s) → Sub-bass Heartbeat →
//   Compressor → Pan Estéreo → Output
// ==========================================

function gerarReverbCatacumba(ctx, duracao = 4) {
    const length = ctx.sampleRate * duracao;
    const impulse = ctx.createBuffer(2, length, ctx.sampleRate);
    for (let ch = 0; ch < 2; ch++) {
        const data = impulse.getChannelData(ch);
        for (let i = 0; i < length; i++) {
            const n = i / length;
            // Catacumba: decay lento com reflexões densas
            const decay = Math.pow(1 - n, 2.5);
            const diffuse = (Math.random() * 2 - 1) * decay;
            // Adicionar modulação de câmara com ecos espaçados
            const echo = (i % Math.floor(ctx.sampleRate * 0.12) < 80) ? 0.15 : 0;
            data[i] = diffuse + (echo * (Math.random() * 2 - 1) * decay * 0.3);
        }
    }
    const convolver = ctx.createConvolver();
    convolver.buffer = impulse;
    return convolver;
}

async function sussurroDemonioBrasil(texto, modoAkasha = false) {
    if (!ttsSombrioAtivo) return;
    if (window.speechSynthesis) window.speechSynthesis.cancel();

    let textoLimpo = texto.replace(/[\u1000-\uFFFF]/g, '').replace(/\[.*?\]/g, '').replace(/[\*_~]/g, '').trim();
    if (!textoLimpo) return;

    const ctx = audioContextoProfundo;
    try {
        if (ctx.state === 'suspended') await ctx.resume();

        // TENTAR GOOGLE TTS PRIMEIRO (como áudio source para processar)
        let audioBuffer = null;
        try {
            const urlAPI = `/api/tts?text=${encodeURIComponent(textoLimpo)}`;
            const res = await fetch(urlAPI);
            if (res.ok) {
                const ct = res.headers.get('content-type');
                if (!ct || !ct.includes('text/html')) {
                    const buf = await res.arrayBuffer();
                    audioBuffer = await ctx.decodeAudioData(buf);
                }
            }
        } catch(e) { /* Google TTS falhou, usar SpeechSynthesis */ }

        if (audioBuffer) {
            // =============================================
            // MODO ÁUDIO COMPLETO (3 CAMADAS SOBRENATURAIS)
            // =============================================
            const t = ctx.currentTime;

            // === CAMADA 1: VOZ PRINCIPAL (Grave ou Eclética Akasha) ===
            const main = ctx.createBufferSource();
            main.buffer = audioBuffer;
            main.playbackRate.value = modoAkasha ? 0.94 : 0.82;

            // === CAMADA 2: SUSSURRO FANTASMAL (Agudo, etéreo) ===
            const ghost = ctx.createBufferSource();
            ghost.buffer = audioBuffer;
            ghost.playbackRate.value = modoAkasha ? 1.48 : 1.35;
            const ghostGain = ctx.createGain();
            ghostGain.gain.value = modoAkasha ? 0.22 : 0.12;
            const ghostDelay = ctx.createDelay();
            ghostDelay.delayTime.value = modoAkasha ? 0.05 : 0.08;

            // === CAMADA 3: ECO ABISSAL (Profundo / Ancestral) ===
            const abyss = ctx.createBufferSource();
            abyss.buffer = audioBuffer;
            abyss.playbackRate.value = modoAkasha ? 0.68 : 0.55;
            const abyssGain = ctx.createGain();
            abyssGain.gain.value = modoAkasha ? 0.09 : 0.06;
            const abyssDelay = ctx.createDelay();
            abyssDelay.delayTime.value = 0.25;

            // === PAN ESTÉREO ROTATIVO ===
            const panMain = ctx.createStereoPanner();
            const panGhost = ctx.createStereoPanner();
            panMain.pan.value = -0.15;
            panGhost.pan.value = 0.15;
            // LFO para rotação panorâmica
            const lfo = ctx.createOscillator();
            const lfoGainNode = ctx.createGain();
            lfo.frequency.value = 0.3;
            lfoGainNode.gain.value = 0.08;
            lfo.connect(lfoGainNode);
            lfoGainNode.connect(panMain.pan);

            // === CHORUS via delay modulado ===
            const chorusDelay = ctx.createDelay();
            chorusDelay.delayTime.value = 0.015;
            const chorusLfo = ctx.createOscillator();
            const chorusLfoGain = ctx.createGain();
            chorusLfo.frequency.value = 0.5;
            chorusLfoGain.gain.value = 0.004;
            chorusLfo.connect(chorusLfoGain);
            chorusLfoGain.connect(chorusDelay.delayTime);

            // === FILTROS ===
            const trebleCut = ctx.createBiquadFilter();
            trebleCut.type = 'highshelf'; trebleCut.frequency.value = 3500; trebleCut.gain.value = -14;
            const midPresence = ctx.createBiquadFilter();
            midPresence.type = 'peaking'; midPresence.frequency.value = 1200; midPresence.gain.value = 4; midPresence.Q.value = 1.5;
            const bassBoost = ctx.createBiquadFilter();
            bassBoost.type = 'lowshelf'; bassBoost.frequency.value = 200; bassBoost.gain.value = 14;

            // === DISTORÇÃO DEMONÍACA ===
            const dist = ctx.createWaveShaper();
            dist.curve = gerarCurvaDistorcao(15);
            dist.oversample = '4x';
            const distGain = ctx.createGain();
            distGain.gain.value = 0.15;

            // === COMPRESSOR DINÂMICO ===
            const comp = ctx.createDynamicsCompressor();
            comp.threshold.value = -24; comp.ratio.value = 12;
            comp.attack.value = 0.003; comp.release.value = 0.3;

            // === SUB-BASS HEARTBEAT (Batida cardíaca 1.2Hz) ===
            const heartbeat = ctx.createOscillator();
            const hbGain = ctx.createGain();
            heartbeat.type = 'sine';
            heartbeat.frequency.value = 55;
            hbGain.gain.setValueAtTime(0, t);
            // Pulsação cardíaca via LFO
            const hbLfo = ctx.createOscillator();
            const hbLfoGain = ctx.createGain();
            hbLfo.frequency.value = 1.2;
            hbLfoGain.gain.value = 0.06;
            hbLfo.connect(hbLfoGain);
            hbLfoGain.connect(hbGain.gain);

            // === REVERB CATACUMBA (4 a 5 segundos de decay) ===
            const reverb = gerarReverbCatacumba(ctx, modoAkasha ? 5 : 4);
            const wetGain = ctx.createGain();
            wetGain.gain.value = modoAkasha ? 0.65 : 0.55;
            const dryGain = ctx.createGain();
            dryGain.gain.value = 0.85;

            // === FADE IN/OUT MASTER ===
            const masterGain = ctx.createGain();
            masterGain.gain.setValueAtTime(0, t);
            masterGain.gain.linearRampToValueAtTime(0.9, t + 0.12);

            // === ROUTING ===
            // Camada principal
            main.connect(panMain);
            main.connect(chorusDelay);
            chorusDelay.connect(panMain);
            panMain.connect(trebleCut);

            // Camada fantasma
            ghost.connect(ghostDelay);
            ghostDelay.connect(ghostGain);
            ghostGain.connect(panGhost);
            panGhost.connect(trebleCut);

            // Camada abissal
            abyss.connect(abyssDelay);
            abyssDelay.connect(abyssGain);
            abyssGain.connect(trebleCut);

            // Filtros → Distorção → Compressor
            trebleCut.connect(midPresence);
            midPresence.connect(bassBoost);
            bassBoost.connect(masterGain);
            masterGain.connect(comp);
            masterGain.connect(dist);
            dist.connect(distGain);
            distGain.connect(comp);

            // Compressor → Dry + Reverb
            comp.connect(dryGain);
            comp.connect(reverb);
            reverb.connect(wetGain);

            // Sub-bass heartbeat
            heartbeat.connect(hbGain);
            hbGain.connect(comp);

            // Output
            dryGain.connect(ctx.destination);
            wetGain.connect(ctx.destination);

            // === START ===
            lfo.start(t);
            chorusLfo.start(t);
            heartbeat.start(t);
            hbLfo.start(t);
            main.start(t);
            ghost.start(t);
            abyss.start(t);

            // Auto-cleanup
            const duration = audioBuffer.duration / (modoAkasha ? 0.94 : 0.82) + 5;
            main.onended = () => {
                try { lfo.stop(); chorusLfo.stop(); heartbeat.stop(); hbLfo.stop(); } catch(e){}
            };
            setTimeout(() => {
                try { ghost.stop(); abyss.stop(); } catch(e){}
            }, duration * 1000);

        } else {
            // =============================================
            // FALLBACK: SpeechSynthesis COM EFEITOS
            // =============================================
            throw new Error('Usar SpeechSynthesis com efeitos');
        }

    } catch (e) {
        // FALLBACK SOBRENATURAL via SpeechSynthesis
        if (!window.speechSynthesis) return;
        
        const utter = new SpeechSynthesisUtterance(textoLimpo);
        utter.lang = 'pt-BR';
        utter.rate = modoAkasha ? 0.76 : 0.72;
        utter.pitch = modoAkasha ? 0.85 : 0.35;
        utter.volume = 0.95;
        
        // Voz apropriada (Akasha: feminina etérea / Padrão: masculina profunda)
        const voices = window.speechSynthesis.getVoices();
        let chosenVoice = null;
        if (modoAkasha) {
            chosenVoice = voices.find(v => v.lang.includes('pt') && (v.name.toLowerCase().includes('female') || v.name.toLowerCase().includes('maria') || v.name.toLowerCase().includes('luciana') || v.name.toLowerCase().includes('francisca') || v.name.toLowerCase().includes('heloisa') || v.name.toLowerCase().includes('vitória'))) || voices.find(v => v.lang.includes('pt'));
        } else {
            chosenVoice = voices.find(v => v.lang.includes('pt') && v.name.toLowerCase().includes('male')) || voices.find(v => v.lang.includes('pt'));
        }
        if (chosenVoice) utter.voice = chosenVoice;
        
        // Sub-bass drone & ressonância enquanto fala
        try {
            if (ctx.state === 'suspended') await ctx.resume();
            const subDrone = ctx.createOscillator();
            const subDroneGain = ctx.createGain();
            subDrone.type = 'sine';
            subDrone.frequency.value = 50;
            subDroneGain.gain.setValueAtTime(0, ctx.currentTime);
            subDroneGain.gain.linearRampToValueAtTime(0.04, ctx.currentTime + 0.5);
            subDrone.connect(subDroneGain);
            subDroneGain.connect(ctx.destination);
            subDrone.start();

            // Drone harmônico místico para Akasha
            let ethDrone = null;
            let ethDroneGain = null;
            if (modoAkasha) {
                ethDrone = ctx.createOscillator();
                ethDroneGain = ctx.createGain();
                ethDrone.type = 'sine';
                ethDrone.frequency.value = 432; // Frequência harmônica etérea
                ethDroneGain.gain.setValueAtTime(0, ctx.currentTime);
                ethDroneGain.gain.linearRampToValueAtTime(0.025, ctx.currentTime + 0.5);
                ethDrone.connect(ethDroneGain);
                ethDroneGain.connect(ctx.destination);
                ethDrone.start();
            }
            
            utter.onend = () => {
                subDroneGain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1);
                if (ethDroneGain) ethDroneGain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1);
                setTimeout(() => { 
                    try { subDrone.stop(); } catch(e){} 
                    try { if (ethDrone) ethDrone.stop(); } catch(e){}
                }, 1500);
            };
        } catch(e) {}
        
        window.speechSynthesis.speak(utter);
    }
}


