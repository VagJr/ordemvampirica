    async function responderConvite(aceitou) {
        document.getElementById('modal-convite-coop').classList.add('oculto');
        if (!conviteAtivo || !aceitou) { conviteAtivo = null; return; }
        
        // CORREÇÃO WASD e UI: Limpar focos e forçar o Ecrã Principal
        if(document.activeElement) document.activeElement.blur();
        document.getElementById('arena-acao').classList.add('oculto');
        document.querySelectorAll('#ui-main').forEach(el => el.style.display = 'block');
        
        try {
            if (conviteAtivo.tipo === 'Masmorra do Abismo') {
                const res = await fetch('/api/dungeon/entrar', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ id: meuVampiro.id, dungeonId: conviteAtivo.extra.dungeonId, partyId: conviteAtivo.extra.partyId })
                });
                const dados = await res.json();
                if(dados.erro) return ocultoAlert(dados.erro);

                dngAtiva = dados.estado;
                
                // Transição de Abas Segura
                document.querySelectorAll('.aba').forEach(el => el.classList.add('oculto'));
                document.getElementById('aba-aventura').classList.remove('oculto');
                document.getElementById('dungeon-lobby').classList.add('oculto');
                document.getElementById('dungeon-game-area').classList.remove('oculto');
                
                // Atualizar o Destaque do Botão no Menu Superior
                document.querySelectorAll('.tabs button').forEach(el => el.classList.remove('active'));
                const btnAventura = document.querySelector(`button[onclick="nav('aventura', this)"]`);
                if(btnAventura) btnAventura.classList.add('active');

                document.getElementById('dungeon-game-area').focus();
                
                socket.emit('dungeon_join', { dungeonId: dngAtiva.id });
                dngLog(`A tua alma desceu ao Abismo para ajudar.`, '#0f5');
                
                // CORREÇÃO TELA PRETA: Renderiza em Cascata para o Motor Gráfico acompanhar o CSS
                renderDungeon();
                setTimeout(renderDungeon, 150);
                setTimeout(renderDungeon, 500);
