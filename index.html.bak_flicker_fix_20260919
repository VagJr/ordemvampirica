    function inicializarEstadosMinigame(projeto) {
        if(projeto.gameplayType === "trilhagem") { ritProximoNó = 1; ritProgresso = 0; }
        else if(projeto.gameplayType === "pressao") { ritPressaoAtual = 10; ritProgresso = 0; }
        else if(projeto.gameplayType === "ritmo") { ritPonteiroRitmoPos = 10; ritProgresso = 0; }
        else if(projeto.gameplayType === "ressonancia") { ritPonteiroRitmoPos = 10; ritProgresso = 0; } 
    }

    function ritDerramar(status) { ritPressaoIsPouring = status; if(status) jorrarSangue(); }

    function ritAtivarNó(nó) {
        if (!ritAtivo || ritProjetoAtivo.gameplayType !== "trilhagem") return;
        if (nó === ritProximoNó) {
            playSfx('espada'); 
            showJuiceNotif("NÓ ATIVADO", `Conexão astral selada em ${nó}`);
            const btnAtual = document.getElementById(`nó-${nó}`);
            if (btnAtual) {
                btnAtual.className = "btn-nó Ativo";
                btnAtual.style.borderColor = "";
                btnAtual.style.boxShadow = "";
            }
            ritProgresso += 20; 
            ritProximoNó++;
            const proxBtn = document.getElementById(`nó-${ritProximoNó}`);
            if (proxBtn) {
                proxBtn.style.borderColor = "#d080ff";
                proxBtn.style.boxShadow = "0 0 15px rgba(208,128,255,0.7)";
            }
            
            document.getElementById('rit-progresso-bar').style.width = `${ritProgresso}%`;
            safeSet('rit-progresso-txt', ritProgresso);

            if (ritProgresso >= 100) encerrarRitualVisceralUnificada(true);
        } else {
            ritProgresso -= 10; 
            playSfx('espada');
            showJuiceNotif("RITO QUEBRADO", `Nó inválido. Tenta Nó ${ritProximoNó}.`);
            if (ritProgresso < 0) ritProgresso = 0;
            document.getElementById('rit-progresso-bar').style.width = `${ritProgresso}%`;
            safeSet('rit-progresso-txt', Math.floor(ritProgresso));
        }
    }

    function ritBaterRitmo() {
        if (!ritAtivo || ritProjetoAtivo.gameplayType !== "ritmo") return;
        if (ritPonteiroRitmoPos >= 40 && ritPonteiroRitmoPos <= 60) {
            ritProgresso += 15;
            jorrarSangue();
            const sg = document.getElementById('rit-sigil-canvas');
            if(sg) sg.style.boxShadow = "inset 0 0 50px #000, 0 0 60px #0f5"; 
        } else {
            ritProgresso -= 10; 
            playSfx('espada');
        }
        
        if (ritProgresso < 0) ritProgresso = 0;
        document.getElementById('rit-progresso-bar').style.width = `${Math.min(100, ritProgresso)}%`;
        safeSet('rit-progresso-txt', Math.floor(ritProgresso));
        if (ritProgresso >= 100) encerrarRitualVisceralUnificada(true);
    }

    function logicaRitualVisceralUnificada() {
        if (!ritAtivo || !ritProjetoAtivo) return;
        const tipo = ritProjetoAtivo.gameplayType;
        const sg = document.getElementById('rit-sigil-canvas');

        if (tipo === "pressao") {
            let resistenciaAbissal = ritProgresso * 0.1; 
            if (ritPressaoIsPouring) ritPressaoAtual += 5; 
            else ritPressaoAtual -= (2 + resistenciaAbissal); 

            if (ritPressaoAtual > 95) ritPressaoAtual = 95;
            if (ritPressaoAtual < 0) ritPressaoAtual = 0;
            
            document.getElementById('rit-ponteiro-pressao').style.left = `${ritPressaoAtual}%`;

            if (ritPressaoAtual >= 40 && ritPressaoAtual <= 60) {
                ritProgresso += 1.0; 
                if(sg) sg.style.boxShadow = "inset 0 0 40px #000, 0 0 50px var(--magia)"; 
            } else {
                ritProgresso -= 0.3; 
                if(sg) sg.style.boxShadow = "inset 0 0 40px #000, 0 0 30px #8a0303";
            }
        } else if (tipo === "ritmo") {
            ritPonteiroRitmoPos += 3; 
            if (ritPonteiroRitmoPos > 95) ritPonteiroRitmoPos = 0; 
            
            document.getElementById('rit-ponteiro-ritmo').style.left = `${ritPonteiroRitmoPos}%`;

        } else if (tipo === "ressonancia") {
            if (ritPressaoIsPouring) ritPonteiroRitmoPos += 4; 
            else ritPonteiroRitmoPos -= 2.5; 

            if (ritPonteiroRitmoPos > 95) ritPonteiroRitmoPos = 95;
            if (ritPonteiroRitmoPos < 0) ritPonteiroRitmoPos = 0;
            document.getElementById('rit-ponteiro-pressao').style.left = `${ritPonteiroRitmoPos}%`;

