	<script>
    // ==========================================
    // 0. DESBLOQUEIO DE ECRÃ E ÁUDIO (SPLASH & VÍDEO)
    // ==========================================
    window.libertarVideo = function() {
        try {
            if (typeof audioCtx !== 'undefined' && audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
            if (typeof audioContextoProfundo !== 'undefined' && audioContextoProfundo && audioContextoProfundo.state === 'suspended') audioContextoProfundo.resume();
            if (typeof SoundEngine !== 'undefined' && SoundEngine && SoundEngine.init) SoundEngine.init();
        } catch(e) { console.warn("Erro ao libertar áudio:", e); }

        const splash = document.getElementById('splash-inicial');
        if (splash) splash.style.display = 'none';

        const introCont = document.getElementById('intro-video-container');
        const video = document.getElementById('video-intro');

        if (introCont) {
            introCont.classList.remove('oculto');
            introCont.style.display = 'block';
        }

        if (video) {
            video.muted = false;
            video.volume = 1.0;
            video.play().catch(e => {
                console.log("Vídeo bloqueado ou sem arquivo, a saltar diretamente:", e);
                window.pularIntro();
            });
        } else {
            window.pularIntro();
        }
    };

    window.pularIntro = function(event) {
        if (event && event.stopPropagation) event.stopPropagation();

        try {
            if (typeof audioCtx !== 'undefined' && audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
            if (typeof audioContextoProfundo !== 'undefined' && audioContextoProfundo && audioContextoProfundo.state === 'suspended') audioContextoProfundo.resume();
            if (typeof SoundEngine !== 'undefined' && SoundEngine && SoundEngine.init) SoundEngine.init();
        } catch(e) {}

        const splash = document.getElementById('splash-inicial');
        if (splash) splash.style.display = 'none';

        const introCont = document.getElementById('intro-video-container');
        const video = document.getElementById('video-intro');

        if (video) {
            try {
                video.pause();
                video.muted = true;
                video.currentTime = 0;
            } catch(e){}
        }

        if (introCont) {
            introCont.classList.add('oculto');
            introCont.style.display = 'none';
        }
    };

    // ==========================================
    // 1. INICIALIZAÇÃO SEGURA (TELEGRAM & GLOBAIS)
    // ==========================================
    let tg = null;
    try {
        if (window.Telegram && window.Telegram.WebApp) {
            tg = window.Telegram.WebApp;
            tg.expand();
        }
    } catch (e) {
        console.warn("Aviso: Rodando fora do Telegram ou falha na API.");
    }

    // BLINDAGEM CLOUD EXTREMA: Força o uso exclusivo de WebSockets.
    // Usar 'polling' na nuvem faz a tua alma saltar entre instâncias físicas, apagando-te da Masmorra.
    const socket = io({ 
        transports: ['websocket'], 
        upgrade: false,             // Impede que o socket tente mudar de protocolo e quebre a sala
        reconnection: true,
        reconnectionAttempts: Infinity,
        timeout: 10000
    });
	  
	
socket.on('boss_coop_update', (dados) => {
        // Se não estou no combate, ou o meu alvo é diferente do que sofreu dano, ignoro.
        if (!combateAtivo || combateDados.alvoId !== dados.bossId) return;
        
        // Atualiza a Barra de Vida Interna
        combateDados.hpAtualInimigo = dados.hpRestante;
        if(dados.hpMax) combateDados.hpMaxInimigo = dados.hpMax;
        
        atualizarBarras();
        atualizarFaseProceduralBoss(); // Muda a cor do boss se ele estiver a morrer
        
        // Mostra visualmente que um aliado causou dano (Animação flutuante)
        if (dados.dano > 0 && dados.atacante !== meuVampiro.nome) {
            spawnDanoText(`-${Math.floor(dados.dano)} (${dados.atacante})`, "#d080ff");
            // Dá um leve abalo (shake/scale) na entidade para dar impacto
            const bossSprite = document.getElementById('inimigo-icone');
            if(bossSprite) {
                bossSprite.style.transform = "scale(0.9)";
                setTimeout(() => bossSprite.style.transform = "scale(1)", 100);
            }
        }
    });
    socket.on('receber_convite', (dados) => {
        convitePendente = dados;
        
        // A MÁGICA: Move o teu modal atual para fora da Aba da Masmorra, para o topo da tela
        const modal = document.getElementById('modal-convite');
        if (modal) document.body.appendChild(modal);

        // Mantém a tua lógica original intacta
        document.getElementById('convite-msg').innerHTML = `<strong style="color:var(--ouro);">${dados.deNome}</strong> evoca a tua presença para:<br><br><span style="color:var(--magia); font-size:1.2em; font-weight:bold;">${dados.tipo.toUpperCase()}</span>`;
        modal.classList.remove('oculto');
        if (typeof playSfx === 'function') playSfx('magia');
    });
// ==========================================
    // RESPONDER AO CONVITE CO-OP (BLINDADO)
    // ==========================================
    window.responderConvite = async function(aceitou) {
        // 1. FORÇA BRUTA: Fecha o modal independentemente da lógica abaixo não travar
        document.querySelectorAll('[id*="modal-convite"]').forEach(m => {
            m.classList.add('oculto');
            m.style.display = 'none';
        });

        try {
            let convite = null;
            if (typeof convitePendente !== 'undefined' && convitePendente) convite = convitePendente;
            if (typeof conviteAtivo !== 'undefined' && conviteAtivo) convite = conviteAtivo;

            if (!convite || !aceitou) { 
                if (typeof convitePendente !== 'undefined') convitePendente = null; 
                if (typeof conviteAtivo !== 'undefined') conviteAtivo = null; 
                return; 
            }
            
            if (convite.tipo === 'Masmorra do Abismo') {
                const res = await fetch('/api/dungeon/entrar', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ id: meuVampiro.id, dungeonId: convite.extra.dungeonId, partyId: convite.extra.partyId })
                });
                const dados = await res.json();
                if(dados.erro) return typeof ocultoAlert === 'function' ? ocultoAlert(dados.erro) : alert(dados.erro);

                dngAtiva = dados.estado;
                document.querySelectorAll('.aba').forEach(el => el.classList.add('oculto'));
                
                const abaAventura = document.getElementById('aba-aventura');
                if(abaAventura) abaAventura.classList.remove('oculto');
                
                const lobby = document.getElementById('dungeon-lobby');
                if(lobby) lobby.classList.add('oculto');
                
                const gameArea = document.getElementById('dungeon-game-area');
                if(gameArea) { 
                    gameArea.classList.remove('oculto'); 
                    gameArea.focus(); 
                }
                
                socket.emit('dungeon_join', { dungeonId: dngAtiva.id });
                if(typeof dngLog === 'function') dngLog(`A tua alma desceu ao Abismo para ajudar.`, '#0f5');
                if(typeof renderDungeon === 'function') renderDungeon();
            } 
            else if (convite.tipo.startsWith('Combate:')) {
                const ex = convite.extra;
                if(typeof iniciarCombateVisceral === 'function') iniciarCombateVisceral(ex.nomeBoss, ex.idBoss, ex.tipoCombate, ex.hp, ex.isBoss);
            }
        } catch(e) { 
            console.error("Falha ao responder o Chamado:", e);
        }

        // Limpa a memória no final
        if (typeof convitePendente !== 'undefined') convitePendente = null; 
        if (typeof conviteAtivo !== 'undefined') conviteAtivo = null;
    };

    // ==========================================
    // AUTO-BINDER DE BOTÕES (Não precisas mexer no HTML)
    // ==========================================
    // Assim que a página carregar, ele encontra os teus botões atuais e liga as funções de forma segura!
    document.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
            const btnAceitar = document.getElementById('btn-aceitar-convite');
            const btnRecusar = document.getElementById('btn-recusar-convite');
            if (btnAceitar) btnAceitar.onclick = () => window.responderConvite(true);
            if (btnRecusar) btnRecusar.onclick = () => window.responderConvite(false);
        }, 1500);
    });
    // ==========================================
    // AUTO-RECONEXÃO DE REDE (SOBREVIVÊNCIA NO FLY.IO)
    // ==========================================
    socket.on('connect', () => {
        // Se o jogador já estava logado e a rede piscou (reconexão)
        if (typeof meuVampiro !== 'undefined' && meuVampiro && meuVampiro.id) {
            
            // 1. RE-ENTRA na sala de chat e sala privada de CONVITES (priv_ID)
            socket.emit('entrar_chat', { idVampiro: meuVampiro.id, clan: meuVampiro.clan });
            
            // 2. RE-ENTRA na sala de sincronização da Masmorra se estiver em uma
            if (typeof dngAtiva !== 'undefined' && dngAtiva && dngAtiva.id) {
                socket.emit('dungeon_join', { dungeonId: dngAtiva.id });
            }
            
            console.log("🌐 O Fio de Prata foi reestabelecido. Salas sincronizadas.");
        }
    });
    let meuVampiro = null; 
	
	// ==========================================
    // MOTOR DE HISTÓRICO VIVO & INTERCEPTOR
    // ==========================================
    let meuHistoricoPessoal = [];
    
    function registarLogVivo(acao) {
        const hora = new Date().toLocaleTimeString();
        meuHistoricoPessoal.unshift(`<div class="hist-linha"><span class="hist-hora">[${hora}]</span> ${acao}</div>`);
        if (meuHistoricoPessoal.length > 200) meuHistoricoPessoal.pop(); 
        safeSet('hist-pessoal-log', meuHistoricoPessoal.join(''), true);
    }

    const _originalFetchLog = window.fetch;
    window.fetch = async function(...args) {
        const url = args[0];
        if (typeof url === 'string' && url.includes('/api/')) {
            const rota = url.split('/api/')[1];
            let acaoImersiva = "Manipulou o Éter.";
            if (rota.includes('caca/drenar')) acaoImersiva = "Cravou as presas e drenou uma alma.";
            else if (rota.includes('combate/action')) acaoImersiva = "Lutou visceralmente na Arena.";
            else if (rota.includes('alquimia/forjar')) acaoImersiva = "Sintetizou matéria no Caldeirão Alquímico.";
            else if (rota.includes('magia/conjurar')) acaoImersiva = "Proferiu um Ritual de Alta Magia.";
            else if (rota.includes('banco/')) acaoImersiva = "Movimentou Gts no Cálice de Sangue.";
            else if (rota.includes('leilao/')) acaoImersiva = "Transacionou com o Leiloeiro das Almas.";
            else if (rota.includes('conclave/')) acaoImersiva = "Participou nos ritos do Conclave Global.";
            else if (rota.includes('dungeon/')) acaoImersiva = "Avançou nas profundezas da Masmorra.";
            else if (rota.includes('atributos/distribuir')) acaoImersiva = "Ascendeu os seus Atributos Cósmicos.";
            
            if(args[1] && args[1].method === 'POST' && !rota.includes('status') && !rota.includes('auth')) {
                registarLogVivo(acaoImersiva);
            }
        }
        return _originalFetchLog.apply(this, args);
    };

    function renderizarCompendioCompleto() {
        if (!meuVampiro) return;
        const v = meuVampiro;
        
        // BLINDAGEM CONTRA BUG DA MORTE (Se os stats sumirem, o código cria um vazio em vez de crashar)
        const eq = v.equipamentos || { arma: null, armadura: null, amuleto: null };
        const st = v.estatisticas || {}; 
        const inv = v.inventario || {};
        v.bolsa = v.bolsa || [];

        let htmlAnat = `
            <div class="compendio-stat-box">ID Astral <span>${v.id}</span></div>
            <div class="compendio-stat-box">Raça Primordial <span>${v.raca === 'lycan' ? 'Lycan (Seth)' : 'Vampiro (Tiamat)'}</span></div>
            <div class="compendio-stat-box">Geração <span>${v.geracao}</span></div>
            <div class="compendio-stat-box">Clã / Santuário <span>${v.clan}</span></div>
            <div class="compendio-stat-box">Título Atual <span>${v.tituloAtual}</span></div>
