            return ocultoAlert(`A tua mente não suporta mais grimórios (Limite: ${limiteMagias}). Atinge o Grau ${(qtdMagias + 1) * 10} ou conquista novas glórias para expandires o teu saber.`);
        }

        // CUSTOS CRESCENTES
        let custoGts = 3000 + (qtdMagias * 2000);
        let custoFuria = 5 + (qtdMagias * 2);
        
        if (!(await ocultoConfirm(`A Mente Abissal consumirá ${numFmt(custoGts)} Gts e ${custoFuria} Fúrias para forjar uma magia exclusiva para ti. Aceitas?`))) return;
        
        abismoVoid(); jorrarSangue();
        try {
            const res = await fetch('/api/magia/gerar_dinamica', { 
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ id: meuVampiro.id }) 
