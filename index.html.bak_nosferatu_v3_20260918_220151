    function logicaInimigoVisceral() {
        if (!combateAtivo || isSyncing) return; const state = combateDados; const statusEl = document.getElementById('inimigo-status');
        if (state.hpAtualJogador <= 0 || state.hpAtualInimigo <= 0) { processarCicloComServidor(false); return; }
        state.cicloTimer--; document.getElementById('arena-ciclo-timer').innerText = `Ocultismo Sincroniza em: ${(state.cicloTimer / 10).toFixed(1)}s`;
        if (state.cicloTimer <= 0) { processarCicloComServidor(false); return; }

        // NOVA FASE: PREPARAÇÃO INICIAL
        if (state.estadoInimigo === 'preparacao') {
            statusEl.innerText = "A ANALISAR A TUA ALMA..."; 
            statusEl.className = "inimigo-intent intent-idle";
            state.timerAcaoInimigo--;
            if (state.timerAcaoInimigo <= 0) state.estadoInimigo = 'idle'; // Acabou o tempo de paz
            return;
        }

        if (state.estadoInimigo === 'idle') {
            statusEl.innerText = "A Espreitar..."; statusEl.className = "inimigo-intent intent-idle";
            let percHp = state.hpAtualInimigo / state.hpMaxInimigo; let aggro = percHp < 0.2 ? 0.30 : (percHp < 0.5 ? 0.15 : 0.08);
            if (Math.random() < aggro) { let chanceMagia = percHp < 0.3 ? 0.7 : 0.4; state.estadoInimigo = Math.random() < chanceMagia ? 'prep_magia' : 'prep_ataque'; state.timerAcaoInimigo = percHp < 0.4 ? 6 : 10; }
        } 
        else if (state.estadoInimigo.startsWith('prep_')) {
            state.timerAcaoInimigo--;
            if (state.estadoInimigo === 'prep_ataque') { statusEl.innerText = "GOLPE FÍSICO!"; statusEl.className = "inimigo-intent intent-ataque"; } else { statusEl.innerText = "CONJURANDO TREVAS!"; statusEl.className = "inimigo-intent intent-magia"; }
            if (state.timerAcaoInimigo <= 0) {
                let percHp = state.hpAtualInimigo / state.hpMaxInimigo; let danoBase = state.isRaid ? (1000 + (meuVampiro.nivel * 100)) : (100 + (meuVampiro.nivel * 10));
                if (percHp < 0.3) danoBase *= 1.5; let danoSofrido = state.estadoInimigo === 'prep_magia' ? danoBase * 1.5 : danoBase;
                state.hpAtualJogador -= danoSofrido; state.estatisticas.danoSofrido += danoSofrido;
                quebrarCombo("SANGRASTE!"); jorrarSangue(); spawnDanoText(`-${Math.floor(danoSofrido)}`, '#f00');
                state.estadoInimigo = 'idle'; if (state.hpAtualJogador <= 0) processarCicloComServidor(false); else atualizarBarras();
            }
        } 
        else if (state.estadoInimigo === 'vulneravel') { statusEl.innerText = "ATORDOADO! MATA!"; statusEl.className = "inimigo-intent intent-vulneravel"; state.timerAcaoInimigo--; if (state.timerAcaoInimigo <= 0) state.estadoInimigo = 'idle'; }
    }

    async function processarCicloComServidor(foiMorteOuFuga) {
        isSyncing = true; document.getElementById('inimigo-status').innerText = "COLISÃO COM O ÉTER..."; document.getElementById('inimigo-status').className = "inimigo-intent intent-sync";
        
        let relatorio = { 
            ataques: combateDados.estatisticas.ataquesDealt, 
            defesas: combateDados.estatisticas.parries, 
            magias: combateDados.estatisticas.magiasDealt, 
            multiplicadorGeral: 1 + (combateDados.maxCombo * 0.1), 
            danoRealCausado: combateDados.estatisticas.danoCausado, 
            danoRealSofrido: combateDados.estatisticas.danoSofrido, 
            sangueGastoMagia: combateDados.estatisticas.sangueGastoMagia || 0,
            curaRuptura: combateDados.estatisticas.curaRuptura || 0,
            fuga: foiMorteOuFuga 
        };
        const payload = { id: meuVampiro.id, alvoId: combateDados.alvoId, tipoCombate: combateDados.tipoCombate, postura: combateDados.posturaPvP, desempenhoRitmo: relatorio };
        try {
            const res = await fetch('/api/combate/action', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload) }); 
            const dados = await res.json();
            
            if (dados.finalizado && dados.alvoMorto) {
                playSfx('espada'); safeSet('arena-feedback', dados.relato, true);
                document.getElementById('arena-feedback').style.color = "var(--ouro)";
                const selectAlvos = document.getElementById('lista-alvos-pvp');
                if(selectAlvos) { for(let i = 0; i < selectAlvos.options.length; i++) { if(selectAlvos.options[i].value === combateDados.alvoId) selectAlvos.remove(i); } }
                
                // CORREÇÃO: Faltava encerrar a arena aqui
                encerrarArenaFinal(dados.relato);
                return; 
            }

            if (dados.erro || dados.finalizado || foiMorteOuFuga) { 
                // CORREÇÃO: Injeta uma mensagem caso o servidor devolva null na fuga
                let msgFinal = dados.erro || dados.relato || (foiMorteOuFuga ? "Fugiste das brumas. A escuridão poupou-te hoje." : "O combate terminou.");
                encerrarArenaFinal(msgFinal); 
                return; 
            }
            
            combateDados.hpAtualInimigo = dados.hpRestante; 
            combateDados.hpMaxInimigo = dados.hpMax || combateDados.hpMaxInimigo; 
            atualizarFaseProceduralBoss();

            // CORREÇÃO: Manter os dados de magia vivos no reset do ciclo
            let trackMagia = combateDados.estatisticas.sangueGastoMagia || 0;
            let trackCura = combateDados.estatisticas.curaRuptura || 0;
            
            combateDados.estatisticas = { 
                ataquesDealt: 0, magiasDealt: 0, parries: 0, danoSofrido: 0, danoCausado: 0, 
                sangueGastoMagia: trackMagia, curaRuptura: trackCura 
            }; 
            combateDados.cicloTimer = 100;
            combateDados.hpAtualJogador = meuVampiro.hpAtual;
            
            safeSet('arena-feedback', "CONTINUA!"); document.getElementById('arena-feedback').style.color = "var(--ouro)"; 
        } catch(e) { 
            encerrarArenaFinal("O Fio de Prata rompeu-se. Desconectado."); 
        } finally {
            isSyncing = false; 
            syncStatus(); 
        }
    }
    function abortarCombateManual() { if(!combateAtivo || isSyncing) return; processarCicloComServidor(true); }
    function gerarAvatarSombrio(seedNome, isBoss = false) {
        let hash = 0; for (let i = 0; i < seedNome.length; i++) { hash = seedNome.charCodeAt(i) + ((hash << 5) - hash); }
        const r = Math.abs(hash % 200) + 55; const g = Math.abs((hash * 2) % 50); const b = Math.abs((hash * 3) % 100);
        const corBase = `rgb(${r}, ${g}, ${b})`; const corSec = `rgb(${Math.abs((hash*5)%255)}, 0, 0)`;
        const lados = (Math.abs(hash) % 4) + 3; 
        const scale = isBoss ? "scale(1.2)" : "scale(1)";
        
        let poly = ""; const centro = 50; const raio = 40;
        for(let i=0; i<lados; i++) { let angle = (i * 2 * Math.PI) / lados; poly += `${centro + raio * Math.cos(angle)},${centro + raio * Math.sin(angle)} `; }

        return `<svg viewBox="0 0 100 100" style="width:100%; height:100%; filter: drop-shadow(0 0 15px ${corBase}); transform: ${scale};">
                  <polygon points="${poly.trim()}" fill="#050000" stroke="${corBase}" stroke-width="3" />
                  <circle cx="50" cy="50" r="${Math.abs(hash % 15) + 10}" fill="${corSec}" stroke="${corBase}" stroke-width="2" />
                  <path d="M30,50 Q50,70 70,50" fill="none" stroke="${corSec}" stroke-width="4" opacity="${isBoss ? 1 : 0}" />
                </svg>`;
    }
    
