    let audioCtxMagick = null;
    function tocarFrequenciaSolfeggio(freq = 432, duracaoSegundos = 1.8) {
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            if (!audioCtxMagick) audioCtxMagick = new AudioCtx();
            if (audioCtxMagick.state === 'suspended') audioCtxMagick.resume();

            const osc = audioCtxMagick.createOscillator();
            const gain = audioCtxMagick.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, audioCtxMagick.currentTime);

            gain.gain.setValueAtTime(0.01, audioCtxMagick.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.25, audioCtxMagick.currentTime + 0.15);
            gain.gain.exponentialRampToValueAtTime(0.0001, audioCtxMagick.currentTime + duracaoSegundos);

            osc.connect(gain);
            gain.connect(audioCtxMagick.destination);

            osc.start();
            osc.stop(audioCtxMagick.currentTime + duracaoSegundos);
        } catch(e) {}
    }

