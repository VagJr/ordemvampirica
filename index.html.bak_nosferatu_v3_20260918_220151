            <div class="compendio-stat-box">Poder Avaliado (GS) <span>${numFmt(v.poderGeral || 0)}</span></div>
        `;
        safeSet('compendio-anatomia', htmlAnat, true);

        let htmlGuerra = `
            <div class="compendio-stat-box">Mortais Secos (Caça) <span>${numFmt(st.mortaisSecos || 0)}</span></div>
            <div class="compendio-stat-box">Volume Drenado <span>${numFmt(st.totalDrenado || 0)} Gts</span></div>
            <div class="compendio-stat-box">Aberrações/Demónios Mortos <span>${numFmt(st.demoniosMortos || 0)}</span></div>
            <div class="compendio-stat-box">Golpes de Lâmina Desferidos <span>${numFmt(st.ataquesDealt || 0)}</span></div>
            <div class="compendio-stat-box">Defesas (Parries) Perfeitos <span>${numFmt(st.parries || 0)}</span></div>
            <div class="compendio-stat-box">Magias Sombrias Conjuradas <span>${numFmt(st.magiasDealt || 0)}</span></div>
            <div class="compendio-stat-box">Dano Total Causado <span>${numFmt(st.danoCausado || 0)}</span></div>
            <div class="compendio-stat-box">Dano Total Sofrido <span>${numFmt(st.danoSofrido || 0)}</span></div>
        `;
        safeSet('compendio-guerra', htmlGuerra, true);

        let htmlInv = `
            <div class="compendio-stat-box" style="border-color:#ff1e2f;">Vitalidade na Carne <span>${numFmt(v.sangue)} Gts</span></div>
            <div class="compendio-stat-box" style="border-color:#ff1e2f;">Cristal do Cálice (Banco) <span>${numFmt(v.calice)} Gts</span></div>
            <div class="compendio-stat-box">Poeira de Anima <span>${numFmt(inv.anima || 0)}</span></div>
            <div class="compendio-stat-box">Cinzas Fúnebres <span>${numFmt(inv.cinzas || 0)}</span></div>
            <div class="compendio-stat-box">Cristais Vitae <span>${numFmt(inv.vitae || 0)}</span></div>
            <div class="compendio-stat-box">Memórias Ancestrais <span>${numFmt(inv.memoria || 0)}</span></div>
            <div class="compendio-stat-box">Ectoplasma <span>${numFmt(inv.ectoplasma || 0)}</span></div>
            <div class="compendio-stat-box">Pedras da Alma <span>${numFmt(inv.pedraAlma || 0)}</span></div>
            <div class="compendio-stat-box">Vidas Extras (Ankhs) <span>${numFmt(inv.ankh_sangue || 0)}</span></div>
            <div class="compendio-stat-box">Artefatos na Bolsa <span>${v.bolsa.length} itens</span></div>
            <div class="compendio-stat-box" style="margin-top:10px; border-color:#0f5;">Arma Equipada <span>${eq.arma ? eq.arma.nome : 'Nenhuma'}</span></div>
            <div class="compendio-stat-box" style="border-color:#0f5;">Armadura Equipada <span>${eq.armadura ? eq.armadura.nome : 'Nenhuma'}</span></div>
            <div class="compendio-stat-box" style="border-color:#0f5;">Amuleto Equipado <span>${eq.amuleto ? eq.amuleto.nome : 'Nenhum'}</span></div>
        `;
        safeSet('compendio-inventario', htmlInv, true);
    }
    
    var hashAlvoAtual = null; 
    var fendaAtualId = null;
    var dadosCacheServidor = null; 

    var storedTgId = localStorage.getItem('tgId'); 
    var tgUser = tg?.initDataUnsafe?.user; 
    
    if (!tgUser && !storedTgId) { 
        storedTgId = Math.floor(Math.random() * 9000000).toString(); 
        localStorage.setItem('tgId', storedTgId); 
    }
    var idAcesso = tgUser ? tgUser.id : storedTgId;

    if(tgUser) document.getElementById('tg-name').innerText = `Lendo o Fio do Destino: @${tgUser.username || tgUser.first_name}`;
    else document.getElementById('tg-name').innerText = `Identidade Astral: ${idAcesso}`;

    // ==========================================
    // 2. FUNÇÕES AUXILIARES, ÁUDIO E JUICE NOTIFS
    // ==========================================
    function safeSet(id, val, isHTML = false) { const el = document.getElementById(id); if(el) { if(isHTML) el.innerHTML = val; else el.innerText = val; } }
    function numFmt(num) { if(num >= 1000000) return (num/1000000).toFixed(1) + 'M'; if(num >= 1000) return (num/1000).toFixed(1) + 'k'; return num; }

    var audioCtx = null;
    try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    } catch(e) {
        console.warn("AudioContext inicialização pendente de interação do usuário");
    }

    const SoundEngine = {
        droneGain: null,
        sfxGain: null,
        droneActive: false,
        droneOscs: [],
        droneVolume: 0.35,
        sfxVolume: 0.7,

        init() {
            if (!audioCtx) {
                try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e){}
            }
            if (!this.sfxGain && audioCtx) {
                this.sfxGain = audioCtx.createGain();
                this.sfxGain.gain.setValueAtTime(this.sfxVolume, audioCtx.currentTime);
                this.sfxGain.connect(audioCtx.destination);
            }
            if (!this.droneGain && audioCtx) {
                this.droneGain = audioCtx.createGain();
                this.droneGain.gain.setValueAtTime(0, audioCtx.currentTime);
                this.droneGain.connect(audioCtx.destination);
            }
        },

        startDrone() {
            try {
                this.init();
                if (this.droneActive || !audioCtx) return;
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(140, audioCtx.currentTime);
                filter.connect(this.droneGain);

                const osc1 = audioCtx.createOscillator();
                osc1.type = 'sawtooth';
                osc1.frequency.setValueAtTime(55, audioCtx.currentTime);
                osc1.connect(filter);

                const osc2 = audioCtx.createOscillator();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(54.4, audioCtx.currentTime);
                osc2.connect(filter);

                const osc3 = audioCtx.createOscillator();
                osc3.type = 'triangle';
                osc3.frequency.setValueAtTime(110, audioCtx.currentTime);
                const subGain = audioCtx.createGain();
                subGain.gain.setValueAtTime(0.25, audioCtx.currentTime);
                osc3.connect(subGain);
                subGain.connect(filter);

                osc1.start(); osc2.start(); osc3.start();
                this.droneOscs = [osc1, osc2, osc3];
                this.droneGain.gain.setTargetAtTime(this.droneVolume, audioCtx.currentTime, 1.5);
                this.droneActive = true;
                const btn = document.getElementById('btn-toggle-drone');
                if (btn) btn.innerText = "Desativar Drone";
            } catch(e) { console.warn("Erro ao iniciar drone:", e); }
        },

        stopDrone() {
            if (!this.droneActive) return;
            if (this.droneGain && audioCtx) {
                this.droneGain.gain.setTargetAtTime(0, audioCtx.currentTime, 0.8);
            }
            setTimeout(() => {
                this.droneOscs.forEach(o => { try { o.stop(); } catch(e){} });
                this.droneOscs = [];
                this.droneActive = false;
                const btn = document.getElementById('btn-toggle-drone');
                if (btn) btn.innerText = "Ativar Drone";
            }, 900);
        },

        toggleDrone() {
            if (this.droneActive) this.stopDrone();
            else this.startDrone();
        },

        setDroneVolume(v) {
            this.droneVolume = Math.max(0, Math.min(1, parseFloat(v)));
            if (this.droneGain && this.droneActive && audioCtx) {
                this.droneGain.gain.setTargetAtTime(this.droneVolume, audioCtx.currentTime, 0.1);
            }
        },

        setSfxVolume(v) {
            this.sfxVolume = Math.max(0, Math.min(1, parseFloat(v)));
            if (this.sfxGain && audioCtx) {
                this.sfxGain.gain.setTargetAtTime(this.sfxVolume, audioCtx.currentTime, 0.1);
            }
        },

        play(type) {
            try {
                this.init();
                if (!audioCtx) return;
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const t = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const g = audioCtx.createGain();
                osc.connect(g);
                g.connect(this.sfxGain || audioCtx.destination);

                if (type === 'sangue') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(160, t);
                    osc.frequency.exponentialRampToValueAtTime(38, t + 0.5);
                    g.gain.setValueAtTime(0.5, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
                    osc.start(); osc.stop(t + 0.5);
                } else if (type === 'espada') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(900, t);
                    osc.frequency.exponentialRampToValueAtTime(110, t + 0.22);
                    g.gain.setValueAtTime(0.35, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
                    osc.start(); osc.stop(t + 0.22);
                } else if (type === 'magia') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(280, t);
                    osc.frequency.linearRampToValueAtTime(650, t + 0.45);
                    g.gain.setValueAtTime(0.2, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.48);
                    osc.start(); osc.stop(t + 0.48);
                } else if (type === 'levelup') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(380, t);
                    osc.frequency.exponentialRampToValueAtTime(880, t + 0.8);
                    g.gain.setValueAtTime(0.4, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 1.2);
                    osc.start(); osc.stop(t + 1.2);
                } else if (type === 'enochiano') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(75, t);
                    osc.frequency.linearRampToValueAtTime(210, t + 0.7);
                    g.gain.setValueAtTime(0.3, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.85);
                    osc.start(); osc.stop(t + 0.85);
                } else if (type === 'craft') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(520, t);
                    osc.frequency.exponentialRampToValueAtTime(180, t + 0.35);
                    g.gain.setValueAtTime(0.35, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
                    osc.start(); osc.stop(t + 0.35);
                } else if (type === 'coleta') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, t);
                    osc.frequency.exponentialRampToValueAtTime(660, t + 0.3);
                    g.gain.setValueAtTime(0.3, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
                    osc.start(); osc.stop(t + 0.3);
                } else if (type === 'whisper') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(180, t);
                    osc.frequency.linearRampToValueAtTime(120, t + 0.6);
                    g.gain.setValueAtTime(0.15, t);
                    g.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
                    osc.start(); osc.stop(t + 0.6);
                }
            } catch(e) { console.warn("Erro ao tocar SFX:", e); }
        }
    };

