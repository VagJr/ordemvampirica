            const elDoc = document.getElementById('mortal-doc'); if(elDoc) elDoc.classList.remove('oculto');
            if (typeof switchSubSection === 'function') switchSubSection('caca', 'presa');
            
            safeSet('doc-hash', `SIGILO: ${hash}`); safeSet('doc-id', m.id); safeSet('doc-rede', m.plataforma); safeSet('doc-hp', numFmt(m.estado === 'Limbo' ? 0 : m.hp)); safeSet('doc-qualidade', m.qualidade); safeSet('doc-aura', m.leituraAura); safeSet('doc-status-extra', m.donoSelo ? `⚠️ ESCRAVO DE: ${m.donoSelo}` : '🔓 ALMA LIVRE');
            
            const btn = document.getElementById('btn-drenar'); 
            if(btn) { if(m.estado === 'Limbo' || m.estado === 'No Leilao') { btn.innerText = "SANGUE INACESSÍVEL"; btn.disabled = true; } else { btn.innerText = "EXECUTAR ACÇÃO"; btn.disabled = false; } }
            
            const btnAbsolver = document.getElementById('btn-absolver'); 
            if (btnAbsolver) { if (meuVampiro && meuVampiro.geracao === 1) btnAbsolver.classList.remove('oculto'); else btnAbsolver.classList.add('oculto'); }
