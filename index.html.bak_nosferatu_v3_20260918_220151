    function atualizarMedidorAmeaça(hpInimigo, isRaidBoss) {
        const threatEl = document.getElementById('arena-threat-level');
        if (!threatEl) return;

        let ratio = hpInimigo / meuVampiro.hpMax;
        
        if (isRaidBoss) {
            threatEl.innerText = "Ameaça: COLOSSAL (Obrigatório Co-op)";
            threatEl.style.color = "#d080ff";
            threatEl.style.borderColor = "#d080ff";
        } else if (ratio < 0.5) {
            threatEl.innerText = "Ameaça: TRIVIAL (Podes brincar)";
            threatEl.style.color = "#aaa";
            threatEl.style.borderColor = "#555";
        } else if (ratio <= 1.5) {
            threatEl.innerText = "Ameaça: EQUILIBRADA (Foco no Parry)";
            threatEl.style.color = "#0f5";
            threatEl.style.borderColor = "#0f5";
        } else if (ratio <= 3.0) {
            threatEl.innerText = "Ameaça: MORTAL (Prepara curas e magias)";
            threatEl.style.color = "#ff1e2f";
            threatEl.style.borderColor = "#ff1e2f";
        } else {
            threatEl.innerText = "Ameaça: SUICÍDIO (Foge ou morre)";
            threatEl.style.color = "red";
            threatEl.style.borderColor = "red";
            threatEl.style.animation = "pulseRed 0.5s infinite";
        }
    }

