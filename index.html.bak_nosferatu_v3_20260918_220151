    function renderDungeon() {
        if(!dngAtiva || !dngCtx) return;
        
        // Verifica se o jogador existe ANTES de apagar a tela
        const myPlayer = dngAtiva.players[meuVampiro.id];
        if(!myPlayer) return; // Aborta o desenho para não ficar tela preta

        const w = dngCanvas.width; const h = dngCanvas.height;
        dngCtx.clearRect(0, 0, w, h);
        dngCtx.fillStyle = '#050005'; dngCtx.fillRect(0, 0, w, h);

        const offsetX = (w / 2) - (myPlayer.x * TILE_SIZE);
        const offsetY = (h / 2) - (myPlayer.y * TILE_SIZE);

        dngCtx.save();
        dngCtx.translate(offsetX, offsetY);

        for(let y=0; y < dngAtiva.altura; y++) {
            for(let x=0; x < dngAtiva.largura; x++) {
                if (dngAtiva.grid[y][x] === 1) {
                    dngCtx.fillStyle = '#111';
                    dngCtx.fillRect(x*TILE_SIZE, y*TILE_SIZE, TILE_SIZE, TILE_SIZE);
                    dngCtx.strokeStyle = '#300';
                    dngCtx.strokeRect(x*TILE_SIZE, y*TILE_SIZE, TILE_SIZE, TILE_SIZE);
                } else {
                    dngCtx.fillStyle = '#000';
                    dngCtx.fillRect(x*TILE_SIZE, y*TILE_SIZE, TILE_SIZE, TILE_SIZE);
                }
            }
        }

        dngAtiva.entidades.forEach(ent => {
            if(ent.tipo === 'exit') {
                dngCtx.fillStyle = '#111'; dngCtx.shadowBlur = 15; dngCtx.shadowColor = '#fff';
                dngCtx.fillRect(ent.x*TILE_SIZE+2, ent.y*TILE_SIZE+2, TILE_SIZE-4, TILE_SIZE-4);
                dngCtx.fillStyle = '#fff'; dngCtx.font = "12px Arial"; dngCtx.fillText("⬇", ent.x*TILE_SIZE+4, ent.y*TILE_SIZE+15);
                dngCtx.shadowBlur = 0;
            } 
            else if(ent.tipo === 'loot') {
                dngCtx.fillStyle = 'var(--ouro)'; dngCtx.fillRect(ent.x*TILE_SIZE+4, ent.y*TILE_SIZE+4, TILE_SIZE-8, TILE_SIZE-8);
            }
            else if(ent.tipo === 'mob') {
                dngCtx.fillStyle = 'var(--sangue-claro)'; dngCtx.shadowBlur = 10; dngCtx.shadowColor = 'red';
                dngCtx.fillRect(ent.x*TILE_SIZE+2, ent.y*TILE_SIZE+2, TILE_SIZE-4, TILE_SIZE-4);
                dngCtx.shadowBlur = 0;
            }
            else if(ent.tipo === 'boss') {
                dngCtx.fillStyle = '#d080ff'; dngCtx.shadowBlur = 20; dngCtx.shadowColor = 'purple';
                dngCtx.fillRect(ent.x*TILE_SIZE, ent.y*TILE_SIZE, TILE_SIZE, TILE_SIZE);
                dngCtx.shadowBlur = 0;
            }
        });

        for(let pid in dngAtiva.players) {
            const p = dngAtiva.players[pid];
            dngCtx.fillStyle = p.cor;
            dngCtx.shadowBlur = 15; dngCtx.shadowColor = p.cor;
            dngCtx.fillRect(p.x*TILE_SIZE+2, p.y*TILE_SIZE+2, TILE_SIZE-4, TILE_SIZE-4);
            
            dngCtx.shadowBlur = 0; dngCtx.fillStyle = '#fff'; dngCtx.font = "10px Courier";
            dngCtx.fillText(p.nome, p.x*TILE_SIZE - 5, p.y*TILE_SIZE - 5);
        }

        dngCtx.restore();
    }

