    window.onkeydown = function(e) {
        const abaAventura = document.getElementById('aba-aventura');
        const dngArea = document.getElementById('dungeon-game-area');
        
        if(!dngAtiva || !abaAventura || !dngArea) return;
        if(abaAventura.classList.contains('oculto') || dngArea.classList.contains('oculto')) return;
        
        const tag = document.activeElement ? document.activeElement.tagName : '';
        if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
        
        let dx = 0, dy = 0;
        if(e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') dy = -1;
        else if(e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') dy = 1;
        else if(e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') dx = -1;
        else if(e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') dx = 1;
        
        if(dx !== 0 || dy !== 0) { 
            e.preventDefault(); 
            window.emitDngMove(dx, dy); 
        }
    };

