        const dngArea = document.getElementById('dungeon-game-area');
        if (typeof dngAtiva !== 'undefined' && dngAtiva && abaAventura && !abaAventura.classList.contains('oculto') && dngArea && !dngArea.classList.contains('oculto')) {
            let dx = 0, dy = 0;
            if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') dy = -1;
            else if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') dy = 1;
            else if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') dx = -1;
            else if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') dx = 1;
            if (dx !== 0 || dy !== 0) {
                e.preventDefault();
                if (typeof window.emitDngMove === 'function') window.emitDngMove(dx, dy);
                return;
            }
        }

        // Navegação Rápida Global (8 Territórios & Mapa)
        if (e.key === 'm' || e.key === 'M' || e.key === '0' || e.key === '`') nav('mapa');
        else if (e.key === '1') nav('caca');
